# Assistant tool state: local memory, plans and skills. Machine-specific and never shared.
.claude
.workbuddy-ai/

# Scratch space the assistant writes working files into: probes, intermediate tables, captured
# output. Regenerated on demand and meaningless to anyone else, so it never reaches a commit.
.arts/

# Build output and local IDE state
[Bb]in/
[Oo]bj/
.vs/

# Release packages are uploaded as GitHub Release assets, never committed.
artifacts/

# Disposable integration-test directories, credentials, SSH keys and rclone config
.fengsync-test/

# Local user configuration and task journal
FengSync.local.json
FreeFileSync

# Local credentials and configuration exports. Commit a deliberately named,
# reviewed fixture instead when a test needs sample data.
.env
.env.*
!.env.example
**/rclone.conf
*.pem
*.key
*.pfx
*.p12
id_rsa
id_ed25519
web/node_modules/
web/dist/
