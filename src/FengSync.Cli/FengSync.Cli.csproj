<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\FengSync.Core\FengSync.Core.csproj" /></ItemGroup>
  <!-- CLI is used by Task Scheduler, so it must be self-sufficient for remote endpoints. -->
  <ItemGroup>
    <Content Include="..\FengSync\Assets\rclone\rclone.exe" Link="Assets\rclone\rclone.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
