<Window x:Class="FengSync.Views.CloudEndpointEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建云端端点"
        Width="560"
        Height="680"
        MinWidth="480"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="新建云端端点">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="新建云端端点" Style="{StaticResource DisplayTitleTextStyle}" />
            <TextBlock Text="先选择服务类型，再填写连接信息。Google Drive 会在默认浏览器完成授权；SFTP / S3 使用下方填写的凭据。"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,14,0,4">
            <TextBlock x:Name="ServiceLabel" Text="服务" Style="{StaticResource SectionTitleTextStyle}" />
            <ComboBox x:Name="ServiceBox"
                      AutomationProperties.AutomationId="CloudServiceType"
                      AutomationProperties.Name="云端服务类型"
                      AutomationProperties.LabeledBy="{Binding ElementName=ServiceLabel}"
                      Margin="0,4,0,0"
                      SelectedIndex="0"
                      SelectionChanged="Service_Changed">
                <ComboBoxItem Content="Google Drive" />
                <ComboBoxItem Content="SFTP" />
                <ComboBoxItem Content="S3 Bucket" />
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <Grid>
                <StackPanel x:Name="GoogleDrivePanel">
                    <TextBlock Text="显示名称" /><TextBox x:Name="GDriveNameBox" AutomationProperties.Name="Google Drive 显示名称" Text="Google Drive" Margin="0,3,0,10" />
                    <TextBlock Text="Client ID（可选，留空使用 rclone 内置 OAuth）" /><TextBox x:Name="GDriveClientIdBox" AutomationProperties.Name="Google Drive Client ID" Margin="0,3,0,10" />
                    <TextBlock Text="Client Secret（可选）" /><TextBox x:Name="GDriveClientSecretBox" AutomationProperties.Name="Google Drive Client Secret" Margin="0,3,0,10" />
                    <TextBlock Text="远程根目录（可选，稍后也可用“预览文件”浏览）" /><TextBox x:Name="GDriveRootBox" AutomationProperties.Name="Google Drive 远程根目录" Margin="0,3,0,10" />
                </StackPanel>
                <StackPanel x:Name="SftpPanel" Visibility="Collapsed">
                    <TextBlock Text="显示名称" /><TextBox x:Name="SftpNameBox" AutomationProperties.AutomationId="SftpRemoteName" AutomationProperties.Name="SFTP 显示名称" Text="SFTP 连接" Margin="0,3,0,10" />
                    <TextBlock Text="主机" /><TextBox x:Name="SftpHostBox" AutomationProperties.AutomationId="SftpRemoteHost" AutomationProperties.Name="SFTP 主机" Margin="0,3,0,10" />
                    <TextBlock Text="端口" /><TextBox x:Name="SftpPortBox" AutomationProperties.AutomationId="SftpRemotePort" AutomationProperties.Name="SFTP 端口" Text="22" Margin="0,3,0,10" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Text="用户名" /><TextBox x:Name="SftpUserBox" AutomationProperties.AutomationId="SftpRemoteUser" AutomationProperties.Name="SFTP 用户名" Margin="0,3,0,10" />
                    <TextBlock Text="密码（如使用密钥登录可留空）" /><PasswordBox x:Name="SftpPasswordBox" AutomationProperties.AutomationId="SftpRemotePassword" AutomationProperties.Name="SFTP 密码" Margin="0,3,0,10" />
                    <TextBlock Text="私钥文件（可选，与密码二选一）" /><TextBox x:Name="SftpKeyFileBox" AutomationProperties.AutomationId="SftpRemoteKeyFile" AutomationProperties.Name="SFTP 私钥文件" Margin="0,3,0,10" />
                    <TextBlock Text="远程根目录（可选）" /><TextBox x:Name="SftpRootBox" AutomationProperties.AutomationId="SftpRemoteRoot" AutomationProperties.Name="SFTP 远程根目录" Margin="0,3,0,10" />
                </StackPanel>
                <StackPanel x:Name="S3Panel" Visibility="Collapsed">
                    <TextBlock Text="显示名称" /><TextBox x:Name="S3NameBox" AutomationProperties.Name="S3 显示名称" Text="S3 Bucket" Margin="0,3,0,10" />
                    <TextBlock Text="Provider（如 AWS、Minio、Cloudflare 等）" /><TextBox x:Name="S3ProviderBox" AutomationProperties.Name="S3 Provider" Text="AWS" Margin="0,3,0,10" />
                    <TextBlock Text="Access Key ID" /><TextBox x:Name="S3AccessKeyBox" AutomationProperties.Name="S3 Access Key ID" Margin="0,3,0,10" />
                    <TextBlock Text="Secret Access Key" /><PasswordBox x:Name="S3SecretBox" AutomationProperties.Name="S3 Secret Access Key" Margin="0,3,0,10" />
                    <TextBlock Text="Region（如 us-east-1）" /><TextBox x:Name="S3RegionBox" AutomationProperties.Name="S3 Region" Margin="0,3,0,10" />
                    <TextBlock Text="Endpoint（可选，非 AWS 服务填写）" /><TextBox x:Name="S3EndpointBox" AutomationProperties.Name="S3 Endpoint" Margin="0,3,0,10" />
                    <TextBlock Text="Bucket 与根目录（例如 my-bucket/path）" /><TextBox x:Name="S3RootBox" AutomationProperties.Name="S3 Bucket 与根目录" Margin="0,3,0,10" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <GroupBox Grid.Row="3" Header="文件预览（目录树）" Margin="0,10,0,0">
            <TreeView x:Name="PreviewTree" MinHeight="80" BorderThickness="0" AutomationProperties.Name="云端文件预览目录树" />
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="CloudEditorStatus" AutomationProperties.Name="云端端点状态" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="TestButton" AutomationProperties.AutomationId="TestCloudEndpoint" AutomationProperties.Name="测试云端端点连接" Content="测试连接" Click="Test_Click" Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="PreviewButton" AutomationProperties.Name="预览云端端点文件" Content="预览文件" Click="Preview_Click" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveCloudEndpoint" AutomationProperties.Name="保存云端端点" Content="保存" Click="Save_Click" IsDefault="True" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" />
                <Button AutomationProperties.Name="取消新建云端端点" Content="取消" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
