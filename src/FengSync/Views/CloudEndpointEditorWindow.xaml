<Window x:Class="FengSync.Views.CloudEndpointEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Endpoint.WindowTitle], Source={l:Lang}}" Width="560" Height="680" MinWidth="520" MinHeight="620"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="CloudEndpointEditorWindow" AutomationProperties.Name="{Binding [Endpoint.WindowTitle], Source={l:Lang}}">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock x:Name="HeadingText" Text="{Binding [Endpoint.WindowTitle], Source={l:Lang}}" Style="{StaticResource DisplayTitleTextStyle}"/>
   <TextBlock x:Name="StepCaption" Text="{Binding [Endpoint.Step1], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
   <Grid x:Name="StepIndicator" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="StepOneIndicator" Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2"/><Border x:Name="StepTwoIndicator" Grid.Column="2" Height="4" Background="{DynamicResource BorderSubtleBrush}" CornerRadius="2"/></Grid>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,18,0,12">
   <StackPanel x:Name="ChooseServiceStep">
    <TextBlock Text="{Binding [Endpoint.ChooseService], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding [Endpoint.ChooseServiceHint], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12"/>
    <TextBlock Text="{Binding [Endpoint.Service], Source={l:Lang}}"/><ComboBox x:Name="ServiceBox" AutomationProperties.AutomationId="CloudServiceType" AutomationProperties.Name="{Binding [Endpoint.ServiceType], Source={l:Lang}}" SelectionChanged="Service_Changed" Margin="0,4,0,14"/>
    <StackPanel x:Name="ProviderChoicePanel" Visibility="Collapsed">
     <TextBlock Text="S3 Provider"/><ComboBox x:Name="S3ProviderBox" AutomationProperties.AutomationId="S3Provider" AutomationProperties.Name="S3 Provider" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" SelectionChanged="S3Provider_SelectionChanged" Margin="0,4,0,4"/>
     <TextBlock x:Name="ProviderError" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}"/>
     <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="12" Margin="0,8,0,0"><TextBlock x:Name="ProviderDescription" Text="{Binding [Endpoint.LoadingProviders], Source={l:Lang}}" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"/></Border>
    </StackPanel>
   </StackPanel>
   <ScrollViewer x:Name="ConnectionStep" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid>
    <!-- Built from CloudProviderCatalog by BuildProviderFields: every non-S3 provider's form is generated,
         so adding a provider is a descriptor row rather than another hand-written panel here. -->
    <StackPanel x:Name="ProviderFieldsPanel"/>
    <StackPanel x:Name="S3Panel" Visibility="Collapsed">
     <TextBlock x:Name="S3Heading" Text="{Binding [Endpoint.S3Connection], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding [Endpoint.DisplayName], Source={l:Lang}}" Margin="0,8,0,0"/><TextBox x:Name="S3NameBox" AutomationProperties.AutomationId="S3DisplayName" Text="S3 Bucket" TextChanged="S3Field_Changed" Margin="0,3,0,0"/><TextBlock x:Name="DisplayNameError" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}"/>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Access Key ID"/><TextBox x:Name="S3AccessKeyBox" AutomationProperties.AutomationId="S3AccessKeyId" TextChanged="S3Field_Changed" Margin="0,3,0,0"/><TextBlock x:Name="AccessKeyError" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Secret Access Key"/><Grid Margin="0,3,0,0"><PasswordBox x:Name="S3SecretBox" AutomationProperties.AutomationId="S3SecretAccessKey" PasswordChanged="S3Secret_Changed" Padding="4,0,34,0"/><TextBox x:Name="S3SecretVisibleBox" Visibility="Collapsed" TextChanged="S3SecretVisible_Changed" Padding="4,0,34,0"/><Button Content="{Binding [Endpoint.Show], Source={l:Lang}}" Click="ToggleSecret_Click" Width="40" HorizontalAlignment="Right" Style="{StaticResource TertiaryButtonStyle}" AutomationProperties.Name="{Binding [Endpoint.ToggleSecret], Source={l:Lang}}"/></Grid><TextBlock x:Name="SecretError" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Grid>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Endpoint"/><TextBox x:Name="S3EndpointBox" AutomationProperties.AutomationId="S3Endpoint" TextChanged="S3Field_Changed" Margin="0,3,0,0"/><TextBlock x:Name="EndpointError" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Region"/><ComboBox x:Name="S3RegionBox" AutomationProperties.AutomationId="S3Region" IsEditable="True" Text="us-east-1" SelectionChanged="S3Region_Changed" Margin="0,3,0,0"/><TextBlock x:Name="RegionHint" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Grid>
     <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Bucket"/><TextBox x:Name="S3BucketBox" AutomationProperties.AutomationId="S3Bucket" TextChanged="S3Field_Changed" Margin="0,3,0,0"/><TextBlock x:Name="BucketError" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding [Endpoint.Prefix], Source={l:Lang}}"/><TextBox x:Name="S3SubdirectoryBox" AutomationProperties.AutomationId="S3Subdirectory" TextChanged="S3Field_Changed" Margin="0,3,0,0"/><TextBlock x:Name="SubdirectoryError" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource CaptionTextStyle}"/><TextBlock Text="{Binding [Endpoint.PrefixHint], Source={l:Lang}}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource CaptionTextStyle}"/><!-- AutomationId stays S3Subdirectory: the UI acceptance scenario drives this field by that id. --></StackPanel></Grid>
     <Border x:Name="ProbeResultCard" Visibility="Collapsed" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="10" Margin="0,6,0,0"><DockPanel><Button x:Name="BrowseProbeButton" Content="{Binding [Endpoint.BrowseDirectory], Source={l:Lang}}" Click="BrowseProbe_Click" DockPanel.Dock="Right" Style="{StaticResource TertiaryButtonStyle}"/><TextBlock x:Name="ProbeResultText" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
    </StackPanel>
   </Grid></ScrollViewer>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" AutomationProperties.AutomationId="CloudEditorStatus" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" AutomationProperties.AutomationId="BackCloudEndpoint" Content="{Binding [Endpoint.Back], Source={l:Lang}}" Click="Back_Click" Visibility="Collapsed" Style="{StaticResource TertiaryButtonStyle}"/><Button x:Name="TestButton" AutomationProperties.AutomationId="TestCloudEndpoint" Content="{Binding [Endpoint.TestConnection], Source={l:Lang}}" Click="Test_Click" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="NextButton" AutomationProperties.AutomationId="NextCloudEndpoint" Content="{Binding [Endpoint.Next], Source={l:Lang}}" Click="Next_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveCloudEndpoint" Content="{Binding [Endpoint.Save], Source={l:Lang}}" Click="Save_Click" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{Binding [Endpoint.Cancel], Source={l:Lang}}" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}"/></StackPanel></Grid>
 </Grid>
</Window>
