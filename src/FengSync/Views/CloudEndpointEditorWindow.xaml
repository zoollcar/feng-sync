<Window x:Class="FengSync.Views.CloudEndpointEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="新建云端端点" Width="560" Height="680" MinWidth="480" MinHeight="520" WindowStartupLocation="CenterOwner">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="新建云端端点" FontSize="20" FontWeight="Bold"/>
   <TextBlock Text="先选择服务类型，再填写连接信息。Google Drive 会在默认浏览器完成授权；SFTP / S3 使用下方填写的凭据。" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0"/>
  </StackPanel>

  <StackPanel Grid.Row="1" Margin="0,14,0,4">
   <TextBlock Text="服务" FontWeight="SemiBold"/>
   <ComboBox x:Name="ServiceBox" Margin="0,4,0,0" SelectedIndex="0" SelectionChanged="Service_Changed">
    <ComboBoxItem Content="Google Drive"/><ComboBoxItem Content="SFTP"/><ComboBoxItem Content="S3 Bucket"/>
   </ComboBox>
  </StackPanel>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><Grid>
   <!-- Google Drive -->
   <StackPanel x:Name="GoogleDrivePanel">
    <TextBlock Text="显示名称"/><TextBox x:Name="GDriveNameBox" Text="Google Drive" Margin="0,3,0,10"/>
    <TextBlock Text="Client ID（可选，留空使用 rclone 内置 OAuth）"/><TextBox x:Name="GDriveClientIdBox" Margin="0,3,0,10"/>
    <TextBlock Text="Client Secret（可选）"/><TextBox x:Name="GDriveClientSecretBox" Margin="0,3,0,10"/>
    <TextBlock Text="远程根目录（可选，稍后也可用“预览文件”浏览）"/><TextBox x:Name="GDriveRootBox" Margin="0,3,0,10"/>
   </StackPanel>
   <!-- SFTP -->
   <StackPanel x:Name="SftpPanel" Visibility="Collapsed">
    <TextBlock Text="显示名称"/><TextBox x:Name="SftpNameBox" Text="SFTP 连接" Margin="0,3,0,10"/>
    <TextBlock Text="主机"/><TextBox x:Name="SftpHostBox" Margin="0,3,0,10"/>
    <TextBlock Text="端口"/><TextBox x:Name="SftpPortBox" Text="22" Margin="0,3,0,10" Width="120" HorizontalAlignment="Left"/>
    <TextBlock Text="用户名"/><TextBox x:Name="SftpUserBox" Margin="0,3,0,10"/>
    <TextBlock Text="密码（如使用密钥登录可留空）"/><PasswordBox x:Name="SftpPasswordBox" Margin="0,3,0,10"/>
    <TextBlock Text="私钥文件（可选，与密码二选一）"/><TextBox x:Name="SftpKeyFileBox" Margin="0,3,0,10"/>
    <TextBlock Text="远程根目录（可选）"/><TextBox x:Name="SftpRootBox" Margin="0,3,0,10"/>
   </StackPanel>
   <!-- S3 -->
   <StackPanel x:Name="S3Panel" Visibility="Collapsed">
    <TextBlock Text="显示名称"/><TextBox x:Name="S3NameBox" Text="S3 Bucket" Margin="0,3,0,10"/>
    <TextBlock Text="Provider（如 AWS、Minio、Cloudflare 等）"/><TextBox x:Name="S3ProviderBox" Text="AWS" Margin="0,3,0,10"/>
    <TextBlock Text="Access Key ID"/><TextBox x:Name="S3AccessKeyBox" Margin="0,3,0,10"/>
    <TextBlock Text="Secret Access Key"/><PasswordBox x:Name="S3SecretBox" Margin="0,3,0,10"/>
    <TextBlock Text="Region（如 us-east-1）"/><TextBox x:Name="S3RegionBox" Margin="0,3,0,10"/>
    <TextBlock Text="Endpoint（可选，非 AWS 服务填写）"/><TextBox x:Name="S3EndpointBox" Margin="0,3,0,10"/>
    <TextBlock Text="Bucket 与根目录（例如 my-bucket/path）"/><TextBox x:Name="S3RootBox" Margin="0,3,0,10"/>
   </StackPanel>
  </Grid></ScrollViewer>

  <GroupBox Grid.Row="3" Header="文件预览（目录树）" Margin="0,10,0,0">
   <TreeView x:Name="PreviewTree" Height="180" BorderThickness="0"/>
  </GroupBox>

  <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Foreground="#4A5863" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="TestButton" Content="测试连接" Click="Test_Click" MinWidth="86"/>
    <Button x:Name="PreviewButton" Content="预览文件" Click="Preview_Click" Margin="8,0,0,0" MinWidth="86"/>
    <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" Margin="8,0,0,0" MinWidth="70"/>
    <Button Content="取消" IsCancel="True" Margin="8,0,0,0" MinWidth="70"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
