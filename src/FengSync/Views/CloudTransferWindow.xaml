<Window x:Class="FengSync.Views.CloudTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="传输"
        Width="900"
        Height="560"
        MinWidth="760"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="CloudTransferWindow"
        AutomationProperties.Name="云盘传输任务">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="传输" Style="{StaticResource DisplayTitleTextStyle}" />
            <!-- No static AutomationProperties.Name: it would replace the live status text, so a screen
                 reader would announce the label instead of the summary the user needs. -->
            <TextBlock x:Name="SummaryText" AutomationProperties.AutomationId="CloudTransferSummary" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ResumeButton" AutomationProperties.AutomationId="ResumeCloudTransfers" AutomationProperties.Name="断点续传未完成的传输" Content="断点续传" Click="Resume_Click" Style="{StaticResource PrimaryButtonStyle}" />
            <Button x:Name="PauseAllButton" AutomationProperties.AutomationId="PauseAllCloudTransfers" AutomationProperties.Name="暂停全部正在进行的传输" Content="全部暂停" Click="PauseAll_Click" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="CancelAllButton" AutomationProperties.AutomationId="CancelAllCloudTransfers" AutomationProperties.Name="取消全部传输" Content="全部取消" Click="CancelAll_Click" Margin="8,0,0,0" Style="{StaticResource DangerButtonStyle}" />
            <Button x:Name="ClearButton" AutomationProperties.AutomationId="ClearCloudTransfers" AutomationProperties.Name="清除已完成的传输并归档" Content="清除已完成" Click="Clear_Click" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
            <Button x:Name="HistoryButton" AutomationProperties.AutomationId="CloudTransferHistory" AutomationProperties.Name="查看已归档的传输记录" Content="传输历史…" Click="History_Click" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
            <Button AutomationProperties.AutomationId="CloseCloudTransfers" AutomationProperties.Name="关闭传输窗口" Content="关闭" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="同时传输数" VerticalAlignment="Center" />
                <ComboBox x:Name="ConcurrencyBox" AutomationProperties.AutomationId="CloudTransferConcurrency" AutomationProperties.Name="同时进行的传输数量" Width="72" Margin="8,0,0,0" SelectionChanged="Concurrency_Changed" />
                <TextBlock Text="完成后" VerticalAlignment="Center" Margin="18,0,0,0" />
                <ComboBox x:Name="AfterTransferBox" AutomationProperties.AutomationId="CloudTransferAfterAction" AutomationProperties.Name="全部传输成功后的动作" Width="170" Margin="8,0,0,0" SelectionChanged="AfterTransfer_Changed" />
                <TextBlock x:Name="ConcurrencyHint" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <!-- Rate ceiling and transfer window come from the settings page; shown here because they change
                 what this window is doing and a parked queue has to explain itself where the user is looking. -->
            <TextBlock x:Name="PolicyText" AutomationProperties.AutomationId="CloudTransferPolicy" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <!-- A ceiling that did not take effect must be visible: silence here is indistinguishable from
                 a limit that is working. -->
            <TextBlock x:Name="LimitErrorText" AutomationProperties.AutomationId="CloudTransferLimitError" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
            <!-- The completion message is a line of text rather than a popup: the app has no tray icon, and
                 a topmost toast would take focus away from whatever the user moved on to. -->
            <Border x:Name="CompletionBanner" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="CompletionText" AutomationProperties.AutomationId="CloudTransferCompletion" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ListView x:Name="TaskList" Grid.Row="3" AutomationProperties.AutomationId="CloudTransferList" AutomationProperties.Name="传输任务列表" BorderThickness="0" ContextMenuOpening="TaskList_ContextMenuOpening">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="任务" Width="240" DisplayMemberBinding="{Binding Display}" />
                    <GridViewColumn Header="进度" Width="170">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="10" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="状态" Width="210" DisplayMemberBinding="{Binding StatusText}" />
                    <GridViewColumn Header="操作" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="暂停" Click="PauseTask_Click" Tag="{Binding}" IsEnabled="{Binding CanPause}" Style="{StaticResource TertiaryButtonStyle}" AutomationProperties.AutomationId="PauseCloudTransfer" AutomationProperties.Name="暂停此传输" />
                                    <!-- One button for both restarting verbs: a paused transfer is continued, one that
                                         stopped on its own is retried, and the label follows the task's state. -->
                                    <Button Content="{Binding RestartText}" Click="RestartTask_Click" Tag="{Binding}" IsEnabled="{Binding IsResumable}" Margin="6,0,0,0" Style="{StaticResource TertiaryButtonStyle}" AutomationProperties.AutomationId="RestartCloudTransfer" AutomationProperties.Name="继续或重试此传输" />
                                    <Button Content="取消" Click="CancelTask_Click" Tag="{Binding}" IsEnabled="{Binding CanCancel}" Margin="6,0,0,0" Style="{StaticResource TertiaryButtonStyle}" AutomationProperties.AutomationId="CancelCloudTransfer" AutomationProperties.Name="取消此传输" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="12" Margin="0,10,0,0">
            <!-- Same reason as the summary above: the hint is the text, so it must stay the accessible name. -->
            <TextBlock x:Name="HintText" AutomationProperties.AutomationId="CloudTransferHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
