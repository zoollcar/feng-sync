<Window x:Class="FengSync.Views.CloudTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="传输"
        Width="780"
        Height="520"
        MinWidth="640"
        MinHeight="380"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="CloudTransferWindow"
        AutomationProperties.Name="云盘传输任务">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="传输" Style="{StaticResource DisplayTitleTextStyle}" />
            <!-- No static AutomationProperties.Name: it would replace the live status text, so a screen
                 reader would announce the label instead of the summary the user needs. -->
            <TextBlock x:Name="SummaryText" AutomationProperties.AutomationId="CloudTransferSummary" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <Button x:Name="ResumeButton" AutomationProperties.AutomationId="ResumeCloudTransfers" AutomationProperties.Name="断点续传未完成的传输" Content="断点续传" Click="Resume_Click" Style="{StaticResource PrimaryButtonStyle}" />
            <Button x:Name="CancelAllButton" AutomationProperties.AutomationId="CancelAllCloudTransfers" AutomationProperties.Name="取消全部传输" Content="全部取消" Click="CancelAll_Click" Margin="8,0,0,0" Style="{StaticResource DangerButtonStyle}" />
            <Button x:Name="ClearButton" AutomationProperties.AutomationId="ClearCloudTransfers" AutomationProperties.Name="清除已完成的传输" Content="清除已完成" Click="Clear_Click" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
            <Button AutomationProperties.AutomationId="CloseCloudTransfers" AutomationProperties.Name="关闭传输窗口" Content="关闭" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
        </StackPanel>

        <ListView x:Name="TaskList" Grid.Row="2" AutomationProperties.AutomationId="CloudTransferList" AutomationProperties.Name="传输任务列表" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="任务" Width="250" DisplayMemberBinding="{Binding Display}" />
                    <GridViewColumn Header="进度" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Value="{Binding Percentage}" Minimum="0" Maximum="100" Height="10" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="状态" Width="230" DisplayMemberBinding="{Binding StatusText}" />
                    <GridViewColumn Header="操作" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="取消" Click="CancelTask_Click" Tag="{Binding}" IsEnabled="{Binding CanCancel}" Style="{StaticResource TertiaryButtonStyle}" AutomationProperties.Name="取消此传输" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="12" Margin="0,10,0,0">
            <!-- Same reason as the summary above: the hint is the text, so it must stay the accessible name. -->
            <TextBlock x:Name="HintText" AutomationProperties.AutomationId="CloudTransferHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
