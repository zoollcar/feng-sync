<Window x:Class="FengSync.Views.ScheduleWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="计划任务" Width="530" Height="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="ProfileText" TextWrapping="Wrap" Margin="0,0,0,15"/>
  <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="任务名称"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="TaskNameBox" AutomationProperties.AutomationId="ScheduleTaskName"/>
  <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,12,0,0" Text="频率"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="ScheduleBox" AutomationProperties.AutomationId="ScheduleFrequency" Margin="0,12,0,0" SelectedIndex="0"><ComboBoxItem Content="DAILY"/><ComboBoxItem Content="WEEKLY"/><ComboBoxItem Content="MONTHLY"/><ComboBoxItem Content="ONLOGON"/><ComboBoxItem Content="ONSTART"/></ComboBox>
  <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="将以无人值守 JSON 模式运行。任务只保存 Profile ID；密码和其他凭据不会写进任务参数。需要将 FengSync.Cli.exe 与应用安装在同一目录。"/>
  <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ResultText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,12,0"/><Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateScheduleButton" Click="Create_Click">创建或更新</Button><Button x:Name="TestButton" AutomationProperties.AutomationId="TestScheduleButton" Click="Test_Click">测试运行</Button><Button x:Name="DeleteButton" AutomationProperties.AutomationId="DeleteScheduleButton" Click="Delete_Click">删除</Button><Button IsCancel="True">关闭</Button></StackPanel>
 </Grid>
</Window>
