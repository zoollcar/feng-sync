<Window x:Class="FengSync.Views.ScheduleWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Schedule.WindowTitle], Source={l:Lang}}"
        Width="530"
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.AutomationId="ScheduleWizard"
        AutomationProperties.Name="{Binding [Schedule.WindowTitle], Source={l:Lang}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{DynamicResource SurfaceBrush}" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                    <TextBlock Text="{Binding [Schedule.WindowTitle], Source={l:Lang}}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Name="ProfileText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,18" />
                </StackPanel>
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding [Schedule.TaskName], Source={l:Lang}}" Style="{StaticResource BodyTextStyle}" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         x:Name="TaskNameBox"
                         AutomationProperties.AutomationId="ScheduleTaskName"
                         AutomationProperties.Name="{Binding [Schedule.TaskNameField], Source={l:Lang}}" />
                <TextBlock Grid.Row="2"
                           VerticalAlignment="Center"
                           Margin="0,12,0,0"
                           Text="{Binding [Schedule.Frequency], Source={l:Lang}}"
                           Style="{StaticResource BodyTextStyle}" />
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          x:Name="ScheduleBox"
                          AutomationProperties.AutomationId="ScheduleFrequency"
                          AutomationProperties.Name="{Binding [Schedule.FrequencyField], Source={l:Lang}}"
                          Margin="0,12,0,0"
                          SelectedIndex="0">
                    <!-- DAILY / WEEKLY / … are the strings Windows Task Scheduler itself is given and reads back. -->
                    <ComboBoxItem Content="DAILY" />
                    <ComboBoxItem Content="WEEKLY" />
                    <ComboBoxItem Content="MONTHLY" />
                    <ComboBoxItem Content="ONLOGON" />
                    <ComboBoxItem Content="ONSTART" />
                </ComboBox>
                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="2"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding [Schedule.Hint], Source={l:Lang}}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button IsCancel="True"
                            Margin="0,0,8,0"
                            Style="{StaticResource TertiaryButtonStyle}"
                            AutomationProperties.Name="{Binding [Schedule.Close], Source={l:Lang}}"
                            Content="{Binding [Schedule.Close], Source={l:Lang}}" />
                    <Button x:Name="DeleteButton"
                            AutomationProperties.AutomationId="DeleteScheduleButton"
                            AutomationProperties.Name="{Binding [Schedule.Delete], Source={l:Lang}}"
                            Click="Delete_Click"
                            Margin="0,0,8,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Content="{Binding [Schedule.Delete], Source={l:Lang}}" />
                    <Button x:Name="TestButton"
                            AutomationProperties.AutomationId="TestScheduleButton"
                            AutomationProperties.Name="{Binding [Schedule.TestRun], Source={l:Lang}}"
                            Click="Test_Click"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding [Schedule.TestRun], Source={l:Lang}}" />
                    <Button x:Name="CreateButton"
                            AutomationProperties.AutomationId="CreateScheduleButton"
                            AutomationProperties.Name="{Binding [Schedule.Create], Source={l:Lang}}"
                            Click="Create_Click"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding [Schedule.Create], Source={l:Lang}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
