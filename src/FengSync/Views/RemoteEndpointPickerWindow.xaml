<Window x:Class="FengSync.Views.RemoteEndpointPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加云端端点" Width="540" Height="600" MinWidth="460" MinHeight="460" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <StackPanel>
   <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitleTextStyle}"/>
   <TextBlock x:Name="SubHeaderText" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>

  <!-- Row 1: endpoint + remote path + browse -->
  <GroupBox Grid.Row="1" Header="选择端点与远程路径" Margin="0,12,0,0">
   <StackPanel Margin="4">
    <TextBlock Text="端点"/>
    <ListBox x:Name="EndpointList" AutomationProperties.AutomationId="PickerEndpointList" BorderThickness="0" DisplayMemberPath="Display" SelectionMode="Single" SelectionChanged="EndpointList_SelectionChanged" Height="140"/>
    <TextBlock Text="远程路径" Margin="0,10,0,0"/>
    <DockPanel Margin="0,3,0,6">
     <Button x:Name="BrowseRemoteButton" DockPanel.Dock="Right" AutomationProperties.AutomationId="PickerBrowseCloudRemote" Content="浏览…" Click="BrowseRemote_Click" MinWidth="72" Margin="8,0,0,0"/>
     <TextBox x:Name="RemotePathBox" AutomationProperties.AutomationId="PickerRemotePath" VerticalContentAlignment="Center" TextChanged="RemotePathBox_TextChanged"/>
    </DockPanel>
    <TextBlock x:Name="ResolvedUriText" AutomationProperties.AutomationId="PickerResolvedUri" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
   </StackPanel>
  </GroupBox>

  <!-- Row 2: add/cancel -->
  <DockPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="PickerStatus" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
    <Button x:Name="AddButton" AutomationProperties.AutomationId="PickerAddButton" Content="添加" IsDefault="True" Click="Add_Click" MinWidth="96" IsEnabled="False"/>
    <Button Content="取消" IsCancel="True" Margin="8,0,0,0" MinWidth="72"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>