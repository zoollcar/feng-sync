<Window x:Class="FengSync.Views.RemoteEndpointPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Picker.WindowTitle], Source={l:Lang}}"
        Width="540"
        Height="600"
        MinWidth="460"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="{Binding [Picker.WindowName], Source={l:Lang}}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource DisplayTitleTextStyle}" />
            <TextBlock x:Name="SubHeaderText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="{Binding [Picker.ChooseGroup], Source={l:Lang}}" Margin="0,12,0,0">
            <StackPanel Margin="4">
                <TextBlock x:Name="PickerEndpointLabel" Text="{Binding [Picker.Endpoint], Source={l:Lang}}" />
                <ListBox x:Name="EndpointList" AutomationProperties.AutomationId="PickerEndpointList" AutomationProperties.Name="{Binding [Picker.AvailableEndpoints], Source={l:Lang}}" AutomationProperties.LabeledBy="{Binding ElementName=PickerEndpointLabel}" BorderThickness="0" DisplayMemberPath="Display" SelectionMode="Single" SelectionChanged="EndpointList_SelectionChanged" Height="140" />
                <TextBlock x:Name="PickerRemotePathLabel" Text="{Binding [Picker.RemotePath], Source={l:Lang}}" Margin="0,10,0,0" />
                <DockPanel Margin="0,3,0,6">
                    <Button x:Name="BrowseRemoteButton" DockPanel.Dock="Right" AutomationProperties.AutomationId="PickerBrowseCloudRemote" AutomationProperties.Name="{Binding [Picker.BrowseAction], Source={l:Lang}}" Content="{Binding [Picker.Browse], Source={l:Lang}}" Click="BrowseRemote_Click" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" />
                    <TextBox x:Name="RemotePathBox" AutomationProperties.AutomationId="PickerRemotePath" AutomationProperties.Name="{Binding [Picker.RemotePath], Source={l:Lang}}" AutomationProperties.LabeledBy="{Binding ElementName=PickerRemotePathLabel}" TextChanged="RemotePathBox_TextChanged" />
                </DockPanel>
                <TextBlock x:Name="ResolvedUriText" AutomationProperties.AutomationId="PickerResolvedUri" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="PickerStatus" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="AddButton" AutomationProperties.AutomationId="PickerAddButton" AutomationProperties.Name="{Binding [Picker.AddAction], Source={l:Lang}}" Content="{Binding [Picker.Add], Source={l:Lang}}" IsDefault="True" Click="Add_Click" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" />
                <Button AutomationProperties.Name="{Binding [Picker.CancelAction], Source={l:Lang}}" Content="{Binding [Picker.Cancel], Source={l:Lang}}" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
