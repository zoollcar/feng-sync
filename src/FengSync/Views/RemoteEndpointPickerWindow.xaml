<Window x:Class="FengSync.Views.RemoteEndpointPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加云端端点"
        Width="540"
        Height="600"
        MinWidth="460"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="添加云端端点到同步配置">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource DisplayTitleTextStyle}" />
            <TextBlock x:Name="SubHeaderText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="选择端点与远程路径" Margin="0,12,0,0">
            <StackPanel Margin="4">
                <TextBlock x:Name="PickerEndpointLabel" Text="端点" />
                <ListBox x:Name="EndpointList" AutomationProperties.AutomationId="PickerEndpointList" AutomationProperties.Name="可用云端端点" AutomationProperties.LabeledBy="{Binding ElementName=PickerEndpointLabel}" BorderThickness="0" DisplayMemberPath="Display" SelectionMode="Single" SelectionChanged="EndpointList_SelectionChanged" Height="140" />
                <TextBlock x:Name="PickerRemotePathLabel" Text="远程路径" Margin="0,10,0,0" />
                <DockPanel Margin="0,3,0,6">
                    <Button x:Name="BrowseRemoteButton" DockPanel.Dock="Right" AutomationProperties.AutomationId="PickerBrowseCloudRemote" AutomationProperties.Name="浏览远程路径" Content="浏览…" Click="BrowseRemote_Click" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" />
                    <TextBox x:Name="RemotePathBox" AutomationProperties.AutomationId="PickerRemotePath" AutomationProperties.Name="远程路径" AutomationProperties.LabeledBy="{Binding ElementName=PickerRemotePathLabel}" TextChanged="RemotePathBox_TextChanged" />
                </DockPanel>
                <TextBlock x:Name="ResolvedUriText" AutomationProperties.AutomationId="PickerResolvedUri" AutomationProperties.Name="解析后的远程地址" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="PickerStatus" AutomationProperties.Name="添加云端端点状态" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="AddButton" AutomationProperties.AutomationId="PickerAddButton" AutomationProperties.Name="添加所选云端端点" Content="添加" IsDefault="True" Click="Add_Click" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" />
                <Button AutomationProperties.Name="取消添加云端端点" Content="取消" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
