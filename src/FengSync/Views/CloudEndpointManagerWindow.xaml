<Window x:Class="FengSync.Views.CloudEndpointManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="云端端点管理" Width="620" Height="720" MinWidth="520" MinHeight="560" WindowStartupLocation="CenterOwner">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <StackPanel>
   <TextBlock Text="云端端点管理" FontSize="20" FontWeight="Bold"/>
   <TextBlock Text="管理已保存的云端端点（Google Drive / SFTP / S3），并从其中浏览远程目录后加入左右同步端点。" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0"/>
  </StackPanel>

  <!-- Top: endpoint list -->
  <GroupBox Grid.Row="1" Header="云端端点列表" Margin="0,12,0,0">
   <ListBox x:Name="EndpointList" BorderThickness="0" DisplayMemberPath="Display" SelectionMode="Single" SelectionChanged="EndpointList_SelectionChanged"/>
  </GroupBox>

  <!-- Below list: four action buttons -->
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
   <Button Content="刷新列表" Click="Refresh_Click" MinWidth="86"/>
   <Button Content="新建端点" Click="New_Click" Margin="8,0,0,0" MinWidth="86"/>
   <Button Content="重新登录" Click="Reconnect_Click" Margin="8,0,0,0" MinWidth="86"/>
   <Button Content="删除端点" Click="Delete_Click" Margin="8,0,0,0" MinWidth="86"/>
  </StackPanel>

  <!-- Below buttons: browse remote directory panel -->
  <GroupBox Grid.Row="3" Header="浏览远程目录" Margin="0,14,0,0">
   <StackPanel Margin="4">
    <TextBlock Text="端点"/>
    <ComboBox x:Name="EndpointSelector" DisplayMemberPath="Display" Margin="0,3,0,10" SelectionChanged="EndpointSelector_SelectionChanged"/>
    <TextBlock Text="远程路径"/>
    <DockPanel Margin="0,3,0,6">
     <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseRemote_Click" MinWidth="72" Margin="8,0,0,0"/>
     <TextBox x:Name="RemotePathBox" VerticalContentAlignment="Center"/>
    </DockPanel>
    <TextBlock x:Name="ResolvedUriText" Foreground="#4A5863" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal">
     <Button Content="添加到左侧" Click="AddLeft_Click" MinWidth="96"/>
     <Button Content="添加到右侧" Click="AddRight_Click" Margin="8,0,0,0" MinWidth="96"/>
     <Button Content="取消" IsCancel="True" Margin="8,0,0,0" MinWidth="72"/>
    </StackPanel>
   </StackPanel>
  </GroupBox>

  <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="#4A5863" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</Window>
