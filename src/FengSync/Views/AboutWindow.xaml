<Window x:Class="FengSync.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 Feng Sync"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="AboutWindow"
        AutomationProperties.Name="关于 Feng Sync">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" Padding="28,26,28,24">
            <StackPanel>
                <TextBlock Text="Feng Sync" Style="{StaticResource DisplayTitleTextStyle}" />
                <TextBlock Text="文件同步工作区" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                <TextBlock x:Name="VersionText"
                           AutomationProperties.AutomationId="AboutVersion"
                           AutomationProperties.Name="当前版本"
                           Margin="0,18,0,0"
                           Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="本地、SFTP、Google Drive 与 S3 的文件比较和同步。"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="GitHub 仓库"
                            Click="Repository_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="在浏览器中打开 Feng Sync 的 GitHub 仓库" />
                    <Button Content="第三方许可"
                            Margin="8,0,0,0"
                            Click="Licenses_Click"
                            Style="{StaticResource TertiaryButtonStyle}"
                            AutomationProperties.Name="查看第三方许可" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="检查更新"
                        AutomationProperties.AutomationId="AboutCheckUpdates"
                        AutomationProperties.Name="检查 Feng Sync 更新"
                        Click="CheckUpdates_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="关闭"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Style="{StaticResource TertiaryButtonStyle}"
                        AutomationProperties.Name="关闭关于 Feng Sync 窗口" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
