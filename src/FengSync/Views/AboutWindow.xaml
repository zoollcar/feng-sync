<Window x:Class="FengSync.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [About.WindowTitle], Source={l:Lang}}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="AboutWindow"
        AutomationProperties.Name="{Binding [About.WindowTitle], Source={l:Lang}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" Padding="28,26,28,24">
            <StackPanel>
                <TextBlock Text="Feng Sync" Style="{StaticResource DisplayTitleTextStyle}" />
                <TextBlock Text="{Binding [About.Tagline], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                <TextBlock x:Name="VersionText"
                           AutomationProperties.AutomationId="AboutVersion"
                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Margin="0,18,0,0"
                           Style="{StaticResource BodyStrongTextStyle}" />
                <TextBlock Text="{Binding [About.Description], Source={l:Lang}}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="{Binding [About.Repository], Source={l:Lang}}"
                            Click="Repository_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            AutomationProperties.Name="{Binding [About.RepositoryName], Source={l:Lang}}" />
                    <Button Content="{Binding [About.Licenses], Source={l:Lang}}"
                            Margin="8,0,0,0"
                            Click="Licenses_Click"
                            Style="{StaticResource TertiaryButtonStyle}"
                            AutomationProperties.Name="{Binding [About.LicensesName], Source={l:Lang}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [About.CheckUpdates], Source={l:Lang}}"
                        AutomationProperties.AutomationId="AboutCheckUpdates"
                        AutomationProperties.Name="{Binding [About.CheckUpdatesName], Source={l:Lang}}"
                        Click="CheckUpdates_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="{Binding [About.Close], Source={l:Lang}}"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Style="{StaticResource TertiaryButtonStyle}"
                        AutomationProperties.Name="{Binding [About.CloseName], Source={l:Lang}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
