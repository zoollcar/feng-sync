<Window x:Class="FengSync.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:System.Windows.Navigation;assembly=PresentationFramework"
        Title="发现更新"
        Width="560"
        Height="460"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="UpdateWindow"
        AutomationProperties.Name="发现 Feng Sync 更新">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="发现更新" Style="{StaticResource DisplayTitleTextStyle}" />
                <TextBlock x:Name="CurrentVersion"
                           AutomationProperties.AutomationId="UpdateCurrentVersion"
                           AutomationProperties.Name="当前版本"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="LatestVersion"
                       Grid.Row="1"
                       Margin="0,18,0,4"
                       Style="{StaticResource BodyStrongTextStyle}"
                       AutomationProperties.AutomationId="UpdateLatestVersion"
                       AutomationProperties.Name="最新版本" />
            <TextBlock Grid.Row="2" Margin="0,0,0,10">
                <Hyperlink x:Name="ReleaseLink"
                           RequestNavigate="ReleaseLink_RequestNavigate"
                           AutomationProperties.Name="在 GitHub 查看完整 Release 说明">在 GitHub 查看完整 Release 说明</Hyperlink>
            </TextBlock>
            <TextBox x:Name="ReleaseNotes"
                     Grid.Row="3"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="UpdateReleaseNotes"
                     AutomationProperties.Name="此版本的更新说明" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel>
                <ProgressBar x:Name="DownloadProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Visibility="Collapsed"
                             AutomationProperties.Name="更新下载进度" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock x:Name="Progress"
                               AutomationProperties.AutomationId="UpdateProgress"
                               AutomationProperties.Name="更新下载状态"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,0,10,0" />
                    <Button x:Name="DownloadButton"
                            Content="下载并更新"
                            AutomationProperties.AutomationId="UpdateDownload"
                            AutomationProperties.Name="下载并安装更新"
                            Click="Download_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="LaterButton"
                            Content="稍后提醒"
                            AutomationProperties.AutomationId="UpdateLater"
                            AutomationProperties.Name="稍后提醒更新"
                            Margin="8,0,0,0"
                            Click="Later_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="SkipButton"
                            Content="跳过此版本"
                            AutomationProperties.AutomationId="UpdateSkip"
                            AutomationProperties.Name="跳过此版本更新"
                            Margin="8,0,0,0"
                            Click="Skip_Click"
                            Style="{StaticResource TertiaryButtonStyle}" />
                    <Button x:Name="CancelButton"
                            Content="取消"
                            AutomationProperties.AutomationId="UpdateCancel"
                            AutomationProperties.Name="取消更新操作"
                            Margin="8,0,0,0"
                            Click="Cancel_Click"
                            Style="{StaticResource TertiaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
