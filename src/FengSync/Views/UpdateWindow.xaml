<Window x:Class="FengSync.Views.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:nav="clr-namespace:System.Windows.Navigation;assembly=PresentationFramework" Title="发现更新" Width="560" Height="460" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="UpdateWindow"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="发现更新" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Name="CurrentVersion" AutomationProperties.AutomationId="UpdateCurrentVersion" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="LatestVersion" Grid.Row="1" Margin="0,18,0,4" FontWeight="SemiBold" AutomationProperties.AutomationId="UpdateLatestVersion"/><TextBlock Grid.Row="2" Margin="0,0,0,10"><Hyperlink x:Name="ReleaseLink" RequestNavigate="ReleaseLink_RequestNavigate">在 GitHub 查看完整 Release 说明</Hyperlink></TextBlock><TextBox x:Name="ReleaseNotes" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="UpdateReleaseNotes" Background="{DynamicResource SurfaceBrush}"/></Grid><Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,12"><StackPanel><ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><TextBlock x:Name="Progress" AutomationProperties.AutomationId="UpdateProgress" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Margin="0,0,10,0"/><Button x:Name="DownloadButton" Content="下载并更新" AutomationProperties.AutomationId="UpdateDownload" Click="Download_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button x:Name="LaterButton" Content="稍后提醒" AutomationProperties.AutomationId="UpdateLater" Margin="8,0,0,0" Click="Later_Click" Style="{StaticResource SecondaryButtonStyle}"/><Button x:Name="SkipButton" Content="跳过此版本" AutomationProperties.AutomationId="UpdateSkip" Margin="8,0,0,0" Click="Skip_Click" Style="{StaticResource GhostButtonStyle}"/><Button x:Name="CancelButton" Content="取消" AutomationProperties.AutomationId="UpdateCancel" Margin="8,0,0,0" Click="Cancel_Click" Style="{StaticResource GhostButtonStyle}"/></StackPanel></StackPanel></Border></Grid></Window>
