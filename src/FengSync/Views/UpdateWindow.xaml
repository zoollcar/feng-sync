<Window x:Class="FengSync.Views.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:nav="clr-namespace:System.Windows.Navigation;assembly=PresentationFramework" Title="发现更新" Width="560" Height="460" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="UpdateWindow"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="CurrentVersion" AutomationProperties.AutomationId="UpdateCurrentVersion"/><TextBlock x:Name="LatestVersion" Grid.Row="1" Margin="0,8,0,2" FontWeight="SemiBold" AutomationProperties.AutomationId="UpdateLatestVersion"/><TextBlock Grid.Row="2" Margin="0,0,0,8"><Hyperlink x:Name="ReleaseLink" RequestNavigate="ReleaseLink_RequestNavigate">在 GitHub 查看完整 Release 说明</Hyperlink></TextBlock><TextBox x:Name="ReleaseNotes" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="UpdateReleaseNotes"/><StackPanel Grid.Row="4" Margin="0,16,0,0"><ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><TextBlock x:Name="Progress" AutomationProperties.AutomationId="UpdateProgress" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="DownloadButton" Content="下载并更新" AutomationProperties.AutomationId="UpdateDownload" Click="Download_Click"/><Button x:Name="LaterButton" Content="稍后提醒" AutomationProperties.AutomationId="UpdateLater" Margin="8,0,0,0" Click="Later_Click"/><Button x:Name="SkipButton" Content="跳过此版本" AutomationProperties.AutomationId="UpdateSkip" Margin="8,0,0,0" Click="Skip_Click"/><Button x:Name="CancelButton" Content="取消" AutomationProperties.AutomationId="UpdateCancel" Margin="8,0,0,0" Click="Cancel_Click"/></StackPanel></StackPanel></Grid></Window>
