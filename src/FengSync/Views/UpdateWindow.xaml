<Window x:Class="FengSync.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:System.Windows.Navigation;assembly=PresentationFramework"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Update.WindowTitle], Source={l:Lang}}"
        Width="560"
        Height="460"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="UpdateWindow"
        AutomationProperties.Name="{Binding [Update.WindowName], Source={l:Lang}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding [Update.Title], Source={l:Lang}}" Style="{StaticResource DisplayTitleTextStyle}" />
                <TextBlock x:Name="CurrentVersion"
                           AutomationProperties.AutomationId="UpdateCurrentVersion"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="LatestVersion"
                       Grid.Row="1"
                       Margin="0,18,0,4"
                       Style="{StaticResource BodyStrongTextStyle}"
                       AutomationProperties.AutomationId="UpdateLatestVersion" />
            <TextBlock Grid.Row="2" Margin="0,0,0,10">
                <Hyperlink x:Name="ReleaseLink"
                           RequestNavigate="ReleaseLink_RequestNavigate"
                           AutomationProperties.Name="{Binding [Update.ReleaseNotesLinkName], Source={l:Lang}}">{Binding [Update.ReleaseNotesLink], Source={l:Lang}}</Hyperlink>
            </TextBlock>
            <TextBox x:Name="ReleaseNotes"
                     Grid.Row="3"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="UpdateReleaseNotes"
                     AutomationProperties.Name="{Binding [Update.ReleaseNotesName], Source={l:Lang}}" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel>
                <ProgressBar x:Name="DownloadProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Visibility="Collapsed"
                             AutomationProperties.Name="{Binding [Update.ProgressName], Source={l:Lang}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock x:Name="Progress"
                               AutomationProperties.AutomationId="UpdateProgress"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,0,10,0" />
                    <Button x:Name="DownloadButton"
                            Content="{Binding [Update.Download], Source={l:Lang}}"
                            AutomationProperties.AutomationId="UpdateDownload"
                            AutomationProperties.Name="{Binding [Update.DownloadName], Source={l:Lang}}"
                            Click="Download_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="LaterButton"
                            Content="{Binding [Update.Later], Source={l:Lang}}"
                            AutomationProperties.AutomationId="UpdateLater"
                            AutomationProperties.Name="{Binding [Update.LaterName], Source={l:Lang}}"
                            Margin="8,0,0,0"
                            Click="Later_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="SkipButton"
                            Content="{Binding [Update.Skip], Source={l:Lang}}"
                            AutomationProperties.AutomationId="UpdateSkip"
                            AutomationProperties.Name="{Binding [Update.SkipName], Source={l:Lang}}"
                            Margin="8,0,0,0"
                            Click="Skip_Click"
                            Style="{StaticResource TertiaryButtonStyle}" />
                    <Button x:Name="CancelButton"
                            Content="{Binding [Update.Cancel], Source={l:Lang}}"
                            AutomationProperties.AutomationId="UpdateCancel"
                            AutomationProperties.Name="{Binding [Update.CancelName], Source={l:Lang}}"
                            Margin="8,0,0,0"
                            Click="Cancel_Click"
                            Style="{StaticResource TertiaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
