<Window x:Class="FengSync.Views.MountPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Mount.Title], Source={l:Lang}}"
        Width="600"
        Height="640"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="MountPickerDialog"
        AutomationProperties.Name="{Binding [Mount.DialogName], Source={l:Lang}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource DisplayTitleTextStyle}" />
            <TextBlock x:Name="SubHeaderText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl x:Name="ModeTabs" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="ModeTabs_SelectionChanged" AutomationProperties.Name="{Binding [Mount.LocationType], Source={l:Lang}}">
            <TabItem Header="{Binding [Mount.TabDrive], Source={l:Lang}}" AutomationProperties.AutomationId="MountPickerDriveTab" AutomationProperties.Name="{Binding [Mount.PickDriveLocation], Source={l:Lang}}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="DriveLetterList"
                             AutomationProperties.AutomationId="MountPickerDriveList"
                             AutomationProperties.Name="{Binding [Mount.AvailableDrives], Source={l:Lang}}"
                             SelectionMode="Single"
                             DisplayMemberPath="Letter"
                             SelectionChanged="DriveLetterList_SelectionChanged" />
                    <TextBlock Grid.Row="1" x:Name="DriveHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="{Binding [Mount.TabDirectory], Source={l:Lang}}" AutomationProperties.AutomationId="MountPickerDirectoryTab" AutomationProperties.Name="{Binding [Mount.PickDirectoryLocation], Source={l:Lang}}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="{Binding [Mount.Browse], Source={l:Lang}}"
                                Click="BrowseDirectory_Click"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.Name="{Binding [Mount.BrowseAndPickDirectory], Source={l:Lang}}" />
                        <TextBox x:Name="DirectoryPathBox"
                                 AutomationProperties.AutomationId="MountPickerDirectoryPath"
                                 AutomationProperties.Name="{Binding [Mount.DirectoryPath], Source={l:Lang}}"
                                 TextChanged="DirectoryPathBox_TextChanged" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" x:Name="DirectoryHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
            <!-- Measured: rclone accepts a UNC mount point and answers with the drive letter Windows allocated
                 for it, so the path the user types is not the mount point that ends up existing. The hint says
                 so rather than promising the path back. -->
            <TabItem Header="{Binding [Mount.TabUnc], Source={l:Lang}}" AutomationProperties.AutomationId="MountPickerUncTab" AutomationProperties.Name="{Binding [Mount.PickUncLocation], Source={l:Lang}}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="UncPathBox"
                             AutomationProperties.AutomationId="MountPickerUncPath"
                             AutomationProperties.Name="{Binding [Mount.UncPath], Source={l:Lang}}"
                             TextChanged="UncPathBox_TextChanged" />
                    <TextBlock Grid.Row="1" x:Name="UncHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Dynamic text, so it carries an AutomationId rather than a static accessible name. -->
        <TextBlock x:Name="CapacityHint"
                   Grid.Row="2"
                   AutomationProperties.AutomationId="MountPickerCapacityHint"
                   Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <Expander x:Name="AdvancedExpander"
                  Grid.Row="3"
                  Header="{Binding [Mount.Advanced], Source={l:Lang}}"
                  Margin="0,12,0,0"
                  AutomationProperties.AutomationId="MountPickerAdvanced"
                  AutomationProperties.Name="{Binding [Mount.AdvancedOptions], Source={l:Lang}}">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,8,4,4">
                    <TextBlock Text="{Binding [Mount.VolumeNameLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox x:Name="VolumeNameBox" AutomationProperties.AutomationId="MountPickerVolumeName" AutomationProperties.Name="{Binding [Mount.VolumeName], Source={l:Lang}}" Margin="0,4,0,10" />

                    <TextBlock Text="{Binding [Mount.CacheModeLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" />
                    <ComboBox x:Name="CacheModeBox" AutomationProperties.AutomationId="MountPickerCacheMode" AutomationProperties.Name="{Binding [Mount.CacheMode], Source={l:Lang}}" Width="220" HorizontalAlignment="Left" Margin="0,4,0,4" SelectionChanged="Advanced_Changed" />
                    <TextBlock x:Name="CacheModeHint" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <TextBlock Text="{Binding [Mount.CacheMaxSizeLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox x:Name="CacheMaxSizeBox" AutomationProperties.AutomationId="MountPickerCacheMaxSize" AutomationProperties.Name="{Binding [Mount.CacheMaxSize], Source={l:Lang}}" Margin="0,4,0,10" />

                    <TextBlock Text="{Binding [Mount.CacheMaxAgeLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox x:Name="CacheMaxAgeBox" AutomationProperties.AutomationId="MountPickerCacheMaxAge" AutomationProperties.Name="{Binding [Mount.CacheMaxAge], Source={l:Lang}}" Margin="0,4,0,10" />

                    <TextBlock Text="{Binding [Mount.WriteBackLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox x:Name="WriteBackBox" AutomationProperties.AutomationId="MountPickerWriteBack" AutomationProperties.Name="{Binding [Mount.WriteBack], Source={l:Lang}}" Margin="0,4,0,10" />

                    <TextBlock Text="{Binding [Mount.DirCacheTimeLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox x:Name="DirCacheTimeBox" AutomationProperties.AutomationId="MountPickerDirCacheTime" AutomationProperties.Name="{Binding [Mount.DirCacheTime], Source={l:Lang}}" Margin="0,4,0,10" />

                    <TextBlock Text="{Binding [Mount.PollIntervalLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBox x:Name="PollIntervalBox" AutomationProperties.AutomationId="MountPickerPollInterval" AutomationProperties.Name="{Binding [Mount.PollInterval], Source={l:Lang}}" Margin="0,4,0,10" />

                    <CheckBox x:Name="NetworkModeBox" AutomationProperties.AutomationId="MountPickerNetworkMode" AutomationProperties.Name="{Binding [Mount.NetworkModeName], Source={l:Lang}}" Content="{Binding [Mount.NetworkMode], Source={l:Lang}}" Margin="0,0,0,6" Checked="Advanced_Changed" Unchecked="Advanced_Changed" />
                    <CheckBox x:Name="ReadOnlyBox" AutomationProperties.AutomationId="MountPickerReadOnly" AutomationProperties.Name="{Binding [Mount.ReadOnlyName], Source={l:Lang}}" Content="{Binding [Mount.ReadOnly], Source={l:Lang}}" Margin="0,0,0,6" Checked="Advanced_Changed" Unchecked="Advanced_Changed" />
                    <CheckBox x:Name="NoChecksumBox" AutomationProperties.AutomationId="MountPickerNoChecksum" AutomationProperties.Name="{Binding [Mount.NoChecksumName], Source={l:Lang}}" Content="{Binding [Mount.NoChecksum], Source={l:Lang}}" Margin="0,0,0,6" Checked="Advanced_Changed" Unchecked="Advanced_Changed" />
                    <CheckBox x:Name="NoModTimeBox" AutomationProperties.AutomationId="MountPickerNoModTime" AutomationProperties.Name="{Binding [Mount.NoModTimeName], Source={l:Lang}}" Content="{Binding [Mount.NoModTime], Source={l:Lang}}" Margin="0,0,0,6" Checked="Advanced_Changed" Unchecked="Advanced_Changed" />
                    <CheckBox x:Name="NoSeekBox" AutomationProperties.AutomationId="MountPickerNoSeek" AutomationProperties.Name="{Binding [Mount.NoSeekName], Source={l:Lang}}" Content="{Binding [Mount.NoSeek], Source={l:Lang}}" Margin="0,0,0,6" Checked="Advanced_Changed" Unchecked="Advanced_Changed" />

                    <!-- No static AutomationProperties.Name: this line *is* the summary of what will be sent. -->
                    <TextBlock x:Name="AdvancedSummary" AutomationProperties.AutomationId="MountPickerAdvancedSummary" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       AutomationProperties.AutomationId="MountPickerStatus"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="OkButton"
                        AutomationProperties.AutomationId="MountPickerOk"
                        AutomationProperties.Name="{Binding [Mount.OkName], Source={l:Lang}}"
                        Content="{Binding [Mount.Ok], Source={l:Lang}}"
                        IsDefault="True"
                        Click="Ok_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="{Binding [Mount.Cancel], Source={l:Lang}}"
                        AutomationProperties.Name="{Binding [Mount.CancelName], Source={l:Lang}}"
                        IsCancel="True"
                        Margin="8,0,0,0"
                        Style="{StaticResource TertiaryButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
