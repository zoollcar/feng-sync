<Window x:Class="FengSync.Views.SftpServerSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SFTP 服务器设置" Width="730" Height="640" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="内置 SFTP 服务器" Style="{StaticResource PageTitleTextStyle}"/>
  <Grid Grid.Row="1" Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <CheckBox x:Name="EnabledBox" Content="启用服务" AutomationProperties.AutomationId="SftpEnabled"/><CheckBox Grid.Column="1" x:Name="AutoStartBox" Content="随 Feng Sync 自动启动" AutomationProperties.AutomationId="SftpAutoStart"/>
   <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="监听地址"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="AddressBox" AutomationProperties.AutomationId="SftpListenAddress"/>
   <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="端口 / 最大连接"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="PortBox" Width="95" AutomationProperties.AutomationId="SftpPort"/><TextBox x:Name="MaxConnectionsBox" Width="95" Margin="8,0,0,0" AutomationProperties.AutomationId="SftpMaxConnections"/></StackPanel>
   <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Node / node_modules"/><StackPanel Grid.Row="3" Grid.Column="1"><TextBox x:Name="NodePathBox" ToolTip="可留空以使用 PATH 中的 node.exe"/><TextBox x:Name="NodeModulesBox" Margin="0,4,0,0" ToolTip="可留空以使用应用 SftpServer\node_modules"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <GroupBox Header="账号"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><Button Click="NewAccount_Click">新建</Button><Button Click="EditAccount_Click" Margin="6,0,0,0">编辑/重置密码</Button><Button Click="RemoveAccount_Click" Margin="6,0,0,0">删除</Button></StackPanel><ListBox x:Name="AccountsList" DisplayMemberPath="UserName"/></DockPanel></GroupBox>
   <GroupBox Grid.Column="2" Header="共享目录"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><Button Click="NewShare_Click">新建</Button><Button Click="EditShare_Click" Margin="6,0,0,0">编辑</Button><Button Click="RemoveShare_Click" Margin="6,0,0,0">删除</Button></StackPanel><ListBox x:Name="SharesList" DisplayMemberPath="VirtualName"/></DockPanel></GroupBox>
  </Grid>
  <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="FingerprintText" AutomationProperties.AutomationId="SftpHostFingerprint" TextWrapping="Wrap"/><TextBlock x:Name="StatusText" AutomationProperties.AutomationId="SftpServerStatus" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Click="Diagnose_Click" AutomationProperties.AutomationId="DiagnoseSftpServer">诊断</Button><Button Click="Start_Click" AutomationProperties.AutomationId="StartSftpServer" Margin="8,0,0,0">启动</Button><Button Click="Stop_Click" AutomationProperties.AutomationId="StopSftpServer" Margin="8,0,0,0">停止</Button><Button Click="Save_Click" Margin="8,0,0,0" IsDefault="True" AutomationProperties.AutomationId="SaveSftpServerSettings">保存</Button><Button IsCancel="True" Margin="8,0,0,0">关闭</Button></StackPanel></Grid>
 </Grid>
</Window>
