<Window x:Class="FengSync.Views.SftpServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Sftp.WindowTitle], Source={l:Lang}}"
        Width="620"
        Height="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.AutomationId="SftpServerSettingsWindow"
        AutomationProperties.Name="{Binding [Sftp.WindowTitle], Source={l:Lang}}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [Sftp.BuiltInServer], Source={l:Lang}}" Style="{StaticResource PageTitleTextStyle}" />

        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox x:Name="EnabledBox"
                      Content="{Binding [Sftp.EnableService], Source={l:Lang}}"
                      AutomationProperties.AutomationId="SftpEnabled"
                      AutomationProperties.Name="{Binding [Sftp.EnableServiceName], Source={l:Lang}}" />
            <CheckBox Grid.Column="1"
                      x:Name="AutoStartBox"
                      Content="{Binding [Sftp.AutoStart], Source={l:Lang}}"
                      AutomationProperties.AutomationId="SftpAutoStart"
                      AutomationProperties.Name="{Binding [Sftp.AutoStartName], Source={l:Lang}}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding [Sftp.ListenAddressLabel], Source={l:Lang}}" Style="{StaticResource BodyTextStyle}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="AddressBox"
                         Width="180"
                         AutomationProperties.AutomationId="SftpListenAddress"
                         AutomationProperties.Name="{Binding [Sftp.ListenAddress], Source={l:Lang}}" />
                <TextBox x:Name="PortBox"
                         Width="95"
                         Margin="8,0,0,0"
                         AutomationProperties.AutomationId="SftpPort"
                         AutomationProperties.Name="{Binding [Sftp.Port], Source={l:Lang}}" />
            </StackPanel>
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding [Sftp.SharedRootLabel], Source={l:Lang}}" Style="{StaticResource BodyTextStyle}" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     x:Name="RootPathBox"
                     AutomationProperties.AutomationId="SftpRootPath"
                     AutomationProperties.Name="{Binding [Sftp.SharedRoot], Source={l:Lang}}" />
            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Binding [Sftp.UserNameLabel], Source={l:Lang}}" Style="{StaticResource BodyTextStyle}" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     x:Name="UserNameBox"
                     AutomationProperties.AutomationId="SftpUserName"
                     AutomationProperties.Name="{Binding [Sftp.UserName], Source={l:Lang}}" />
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{Binding [Sftp.CacheSizeLabel], Source={l:Lang}}" Style="{StaticResource BodyTextStyle}" />
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     x:Name="CacheSizeBox"
                     Width="95"
                     HorizontalAlignment="Left"
                     AutomationProperties.AutomationId="SftpCacheSize"
                     AutomationProperties.Name="{Binding [Sftp.CacheSize], Source={l:Lang}}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PasswordStateText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                <Button Click="SetPassword_Click"
                        Margin="12,0,0,0"
                        AutomationProperties.AutomationId="SetSftpPassword"
                        AutomationProperties.Name="{Binding [Sftp.SetPasswordName], Source={l:Lang}}"
                        Style="{StaticResource SecondaryButtonStyle}" Content="{Binding [Sftp.SetPassword], Source={l:Lang}}"/>
            </StackPanel>
            <TextBlock x:Name="FingerprintText"
                       AutomationProperties.AutomationId="SftpHostFingerprint"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,12,0,0" />
            <TextBlock Text="{Binding [Sftp.LegacyNote], Source={l:Lang}}"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="StatusText"
                       AutomationProperties.AutomationId="SftpServerStatus"
                       AutomationProperties.LiveSetting="Polite"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True"
                        Margin="0,0,8,0"
                        Style="{StaticResource TertiaryButtonStyle}"
                        AutomationProperties.Name="{Binding [Sftp.CloseName], Source={l:Lang}}" Content="{Binding [Sftp.Close], Source={l:Lang}}"/>
                <Button Click="Stop_Click"
                        AutomationProperties.AutomationId="StopSftpServer"
                        AutomationProperties.Name="{Binding [Sftp.StopName], Source={l:Lang}}"
                        Margin="0,0,8,0"
                        Style="{StaticResource TertiaryButtonStyle}" Content="{Binding [Sftp.Stop], Source={l:Lang}}"/>
                <Button Click="Diagnose_Click"
                        AutomationProperties.AutomationId="DiagnoseSftpServer"
                        AutomationProperties.Name="{Binding [Sftp.DiagnoseName], Source={l:Lang}}"
                        Margin="0,0,8,0"
                        Style="{StaticResource TertiaryButtonStyle}" Content="{Binding [Sftp.Diagnose], Source={l:Lang}}"/>
                <Button Click="Start_Click"
                        AutomationProperties.AutomationId="StartSftpServer"
                        AutomationProperties.Name="{Binding [Sftp.StartName], Source={l:Lang}}"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" Content="{Binding [Sftp.Start], Source={l:Lang}}"/>
                <Button Click="Save_Click"
                        IsDefault="True"
                        AutomationProperties.AutomationId="SaveSftpServerSettings"
                        AutomationProperties.Name="{Binding [Sftp.SaveName], Source={l:Lang}}"
                        Style="{StaticResource PrimaryButtonStyle}" Content="{Binding [Sftp.Save], Source={l:Lang}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
