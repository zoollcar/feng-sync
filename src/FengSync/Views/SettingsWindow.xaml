<Window x:Class="FengSync.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序设置" Width="760" Height="560" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="Pages" AutomationProperties.AutomationId="SettingsPages" SelectionChanged="PageChanged">
      <TabItem Header="常规" AutomationProperties.AutomationId="SettingsGeneralTab"><StackPanel Margin="16"><TextBlock Text="常规" Style="{StaticResource SectionTitleTextStyle}"/><CheckBox x:Name="AutoCheckForUpdates" AutomationProperties.AutomationId="SettingsAutoCheckUpdates" Content="自动检查更新" Margin="0,16,0,0" Checked="MarkDirty" Unchecked="MarkDirty"/><CheckBox x:Name="ShowCompleted" AutomationProperties.AutomationId="SettingsShowCompleted" Content="同步完成后保留进度窗口" Margin="0,16,0,0" Checked="MarkDirty" Unchecked="MarkDirty"/><CheckBox x:Name="StartWithWindows" AutomationProperties.AutomationId="SettingsStartWithWindows" Content="随 Windows 启动 Feng Sync" Margin="0,8,0,0" Checked="MarkDirty" Unchecked="MarkDirty"/><TextBlock Text="启动项状态由操作系统管理；更改将在后续集成功能中生效。" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></TabItem>
      <TabItem Header="默认值" AutomationProperties.AutomationId="SettingsDefaultsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="新 Profile 与选择“使用程序默认值”的字段会采用以下值。" TextWrapping="Wrap"/><TextBlock Text="默认最大并发传输数" Margin="0,14,0,2"/><TextBox x:Name="Concurrency" AutomationProperties.AutomationId="SettingsConcurrency" Width="90" HorizontalAlignment="Left" TextChanged="MarkDirty"/><CheckBox x:Name="VerifyCopies" AutomationProperties.AutomationId="SettingsVerifyCopies" Content="默认在复制后验证文件大小" Margin="0,10,0,0" Checked="MarkDirty" Unchecked="MarkDirty"/><TextBlock Text="默认时间容差（秒）" Margin="0,14,0,2"/><TextBox x:Name="TimeTolerance" AutomationProperties.AutomationId="SettingsTimeTolerance" Width="90" HorizontalAlignment="Left" TextChanged="MarkDirty"/><TextBlock Text="默认包含规则（每行一条）" Margin="0,14,0,2"/><TextBox x:Name="IncludeRules" AutomationProperties.AutomationId="SettingsIncludeRules" Height="58" AcceptsReturn="True" TextChanged="MarkDirty"/><TextBlock Text="默认排除规则（每行一条）" Margin="0,10,0,2"/><TextBox x:Name="ExcludeRules" AutomationProperties.AutomationId="SettingsExcludeRules" Height="58" AcceptsReturn="True" TextChanged="MarkDirty"/><TextBlock Text="默认版本策略" Margin="0,14,0,2"/><ComboBox x:Name="VersioningMode" AutomationProperties.AutomationId="SettingsVersioningMode" Width="180" HorizontalAlignment="Left" SelectionChanged="MarkDirty"><ComboBoxItem Content="永久删除"/><ComboBoxItem Content="版本目录"/></ComboBox><TextBlock Text="版本目录" Margin="0,8,0,2"/><TextBox x:Name="ArchiveDirectory" AutomationProperties.AutomationId="SettingsArchiveDirectory" TextChanged="MarkDirty"/><TextBlock Text="保留天数" Margin="0,8,0,2"/><TextBox x:Name="KeepDays" AutomationProperties.AutomationId="SettingsKeepDays" Width="90" HorizontalAlignment="Left" TextChanged="MarkDirty"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="日志与通知"><StackPanel Margin="16"><TextBlock Text="日志与通知" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="日志保留天数" Margin="0,16,0,2"/><TextBox x:Name="LogRetention" Width="90" HorizontalAlignment="Left" TextChanged="MarkDirty"/><CheckBox x:Name="NotifyOnCompletion" Content="同步完成时显示通知" Margin="0,12,0,0" Checked="MarkDirty" Unchecked="MarkDirty"/></StackPanel></TabItem>
      <TabItem Header="连接与性能"><StackPanel Margin="16"><TextBlock Text="连接与性能" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="网络失败重试次数" Margin="0,16,0,2"/><TextBox x:Name="NetworkRetry" Width="90" HorizontalAlignment="Left" TextChanged="MarkDirty"/><TextBlock Text="实际运行的 Profile 覆盖值优先于这里的程序默认值。" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></TabItem>
      <TabItem Header="集成"><StackPanel Margin="16"><TextBlock Text="集成" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="配置内置 SFTP 服务、端口与监听地址。账号和共享目录通过 SFTP 配置管理。" TextWrapping="Wrap" Margin="0,16,0,10"/><Button x:Name="SftpServerSettingsButton" Content="SFTP 服务器设置…" HorizontalAlignment="Left" Click="ConfigureSftp_Click" AutomationProperties.AutomationId="SftpServerSettingsButton"/></StackPanel></TabItem>
      <TabItem Header="维护"><StackPanel Margin="16"><TextBlock Text="维护" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="临时传输文件用于下次同步续传；不会在启动时自动删除。可手动清理超过 7 天的本地临时文件。" TextWrapping="Wrap" Margin="0,16,0,0"/><Button x:Name="CleanupTemporaryFilesButton" Content="清理过期本地临时文件" Click="CleanupTemporaryFiles_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/><TextBlock x:Name="StoragePath" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></TabItem>
    </TabControl>
    <DockPanel Grid.Row="1" Margin="0,14,0,0"><TextBlock x:Name="DirtyLabel" AutomationProperties.AutomationId="SettingsDirtyLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="恢复本页默认值" AutomationProperties.AutomationId="SettingsResetPage" Click="ResetPage_Click" Margin="0,0,18,0"/><Button x:Name="ApplyButton" Content="应用" AutomationProperties.AutomationId="SettingsApply" Click="Apply_Click" Margin="0,0,8,0"/><Button x:Name="OkButton" Content="确定" AutomationProperties.AutomationId="SettingsOk" IsDefault="True" Click="Ok_Click"/><Button Content="取消" AutomationProperties.AutomationId="SettingsCancel" IsCancel="True" Margin="8,0,0,0"/></StackPanel></DockPanel>
  </Grid>
</Window>
