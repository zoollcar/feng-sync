<Window x:Class="FengSync.Views.ProfileEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Profile 设置" Width="860" Height="690" MinWidth="700" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Profile 设置" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="DirtyLabel" Foreground="DarkOrange"/></StackPanel><CheckBox x:Name="Enabled" Grid.Column="1" Content="已启用" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Sections" SelectionChanged="Section_Changed"><ListBoxItem Content="常规" IsSelected="True"/><ListBoxItem Content="比较"/><ListBoxItem Content="过滤器"/><ListBoxItem Content="同步"/><ListBoxItem Content="版本管理"/><ListBoxItem Content="性能与可靠性"/></ListBox>
   <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"><Grid>
    <StackPanel x:Name="GeneralPage"><TextBlock Text="名称"/><TextBox x:Name="NameBox" Margin="0,3,0,10"/><TextBlock Text="说明"/><TextBox x:Name="DescriptionBox" Margin="0,3,0,10"/><TextBlock Text="左侧端点"/><DockPanel Margin="0,3,0,10"><Button DockPanel.Dock="Right" Content="测试" Click="TestLeft_Click" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseLeft_Click" Margin="8,0,0,0"/><TextBox x:Name="LeftPathBox"/></DockPanel><TextBlock Text="右侧端点"/><DockPanel Margin="0,3,0,10"><Button DockPanel.Dock="Right" Content="测试" Click="TestRight_Click" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseRight_Click" Margin="8,0,0,0"/><TextBox x:Name="RightPathBox"/></DockPanel><Button Content="交换左右端点" HorizontalAlignment="Left" Click="SwapEndpoints_Click"/><TextBlock x:Name="EndpointTestResult" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkSlateGray"/></StackPanel>
    <StackPanel x:Name="ComparisonPage" Visibility="Collapsed"><TextBlock Text="比较" FontSize="16" FontWeight="Bold"/><TextBlock Text="时间容差（秒）" Margin="0,14,0,2"/><TextBox x:Name="TimeToleranceBox" Width="90" HorizontalAlignment="Left"/><TextBlock Text="在未启用内容 hash 的比较中，修改时间差不超过此值的文件会被视为时间一致。" TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,0"/></StackPanel>
    <StackPanel x:Name="FilterPage" Visibility="Collapsed"><TextBlock Text="过滤规则" FontSize="16" FontWeight="Bold"/><TextBlock Text="规则按列表顺序计算，后命中规则覆盖先命中规则。禁用规则会保存但不参与扫描。" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Button Content="添加包含" Click="AddIncludeRule_Click"/><Button Content="添加排除" Click="AddExcludeRule_Click" Margin="6,0,0,0"/><Button Content="常用排除" Click="ApplyCommonExcludes_Click" Margin="6,0,0,0"/><Button Content="上移" Click="MoveRuleUp_Click" Margin="18,0,0,0"/><Button Content="下移" Click="MoveRuleDown_Click" Margin="6,0,0,0"/><Button Content="删除" Click="RemoveRule_Click" Margin="6,0,0,0"/></StackPanel><DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="185" SelectionChanged="RuleGrid_SelectionChanged"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="52"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="55"/><DataGridTextColumn Header="模式" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="注释" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="150"/></DataGrid.Columns></DataGrid><Border BorderBrush="#BFC7CF" BorderThickness="1" Padding="8" Margin="0,8,0,8"><StackPanel><TextBlock Text="所选规则的属性条件（留空表示不限）" FontWeight="Bold"/><WrapPanel Margin="0,5,0,0"><TextBlock Text="最小字节" VerticalAlignment="Center"/><TextBox x:Name="RuleMinSizeBox" Width="80" Margin="4,0,10,0"/><TextBlock Text="最大字节" VerticalAlignment="Center"/><TextBox x:Name="RuleMaxSizeBox" Width="80" Margin="4,0,10,0"/><TextBlock Text="修改时间≥" VerticalAlignment="Center"/><TextBox x:Name="RuleAfterBox" Width="130" Margin="4,0,10,0"/><TextBlock Text="修改时间≤" VerticalAlignment="Center"/><TextBox x:Name="RuleBeforeBox" Width="130" Margin="4,0,10,0"/></WrapPanel><WrapPanel Margin="0,6,0,0"><CheckBox x:Name="RuleHiddenBox" Content="仅隐藏文件"/><CheckBox x:Name="RuleSymlinkBox" Content="仅符号链接" Margin="14,0,0,0"/><Button Content="应用属性" Click="ApplyRuleAttributes_Click" Margin="14,0,0,0"/></WrapPanel></StackPanel></Border><Border BorderBrush="#BFC7CF" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="规则测试器" FontWeight="Bold"/><WrapPanel Margin="0,5,0,0"><TextBox x:Name="FilterTestPathBox" Width="230" ToolTip="相对路径，例如 cache/draft.tmp"/><TextBox x:Name="FilterTestSizeBox" Width="80" Margin="6,0,0,0" ToolTip="文件大小（字节）"/><CheckBox x:Name="FilterTestHiddenBox" Content="隐藏" Margin="8,0,0,0"/><CheckBox x:Name="FilterTestSymlinkBox" Content="符号链接" Margin="8,0,0,0"/><Button Content="测试" Click="TestFilter_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="FilterTestResult" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
    <StackPanel x:Name="SyncPage" Visibility="Collapsed"><TextBlock Text="同步模式"/><ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="0,3,0,10"><ComboBoxItem Content="双向 ↔"/><ComboBoxItem Content="镜像 →"/><ComboBoxItem Content="更新 →"/><ComboBoxItem Content="自定义（尚不可用）" IsEnabled="False" ToolTip="自定义模式尚未实现，不能保存或执行。"/></ComboBox><TextBlock Text="自定义模式在当前版本不可用；请选择双向、镜像或更新。" Foreground="DarkOrange" TextWrapping="Wrap"/><TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,12,0,0"/></StackPanel>
    <StackPanel x:Name="VersioningPage" Visibility="Collapsed"><TextBlock Text="版本管理" FontSize="16" FontWeight="Bold"/><ComboBox x:Name="VersioningBox" SelectedIndex="0" Margin="0,8,0,3"><ComboBoxItem Content="永久删除"/><ComboBoxItem Content="版本目录"/><ComboBoxItem Content="回收站（仅 Windows 本地端点）"/></ComboBox><TextBlock Text="版本归档目录" Margin="0,8,0,2"/><TextBox x:Name="ArchiveBox" Margin="0,3,0,8" ToolTip="版本归档目录"/><WrapPanel><TextBlock Text="保留天数" VerticalAlignment="Center"/><TextBox x:Name="KeepDaysBox" Width="72" Margin="5,0,14,0"/><TextBlock Text="每文件版本数" VerticalAlignment="Center"/><TextBox x:Name="MaxVersionsBox" Width="72" Margin="5,0,14,0"/><TextBlock Text="总容量 MB" VerticalAlignment="Center"/><TextBox x:Name="MaxTotalMbBox" Width="92" Margin="5,0,0,0"/></WrapPanel><TextBlock Text="留空的数量或容量不设限制；同步完成后会自动按此策略清理归档。" TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,8"/><StackPanel Orientation="Horizontal"><Button Content="预览清理" Click="PreviewRetention_Click"/><Button Content="立即清理" Click="CleanupRetention_Click" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="RetentionResult" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <StackPanel x:Name="PerformancePage" Visibility="Collapsed"><CheckBox x:Name="UseDefaultCopies" Content="复制验证使用程序默认值" Checked="UseDefaultCopies_Changed" Unchecked="UseDefaultCopies_Changed"/><CheckBox x:Name="VerifyCopies" Content="复制后验证文件" Margin="0,3,0,10"/><CheckBox x:Name="UseDefaultConcurrency" Content="并发数使用程序默认值" Checked="UseDefaultConcurrency_Changed" Unchecked="UseDefaultConcurrency_Changed"/><StackPanel Orientation="Horizontal" Margin="0,3,0,10"><TextBlock Text="最大并发数：" VerticalAlignment="Center"/><TextBox x:Name="ConcurrencyBox" Width="60"/></StackPanel></StackPanel>
   </Grid></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="SaveAs_Click" Margin="0,0,8,0">另存为新 Profile</Button><Button Click="Save_Click" IsDefault="True">保存</Button><Button IsCancel="True" Margin="8,0,0,0">取消</Button></StackPanel>
 </Grid>
</Window>
