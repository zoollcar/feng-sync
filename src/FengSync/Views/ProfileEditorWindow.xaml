<Window x:Class="FengSync.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Profile.WindowTitle], Source={l:Lang}}" Width="860" Height="690" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.AutomationId="ProfileEditorWindow"
        AutomationProperties.Name="{Binding [Profile.WindowTitle], Source={l:Lang}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding [Profile.WindowTitle], Source={l:Lang}}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Name="DirtyLabel" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <CheckBox x:Name="Enabled" Grid.Column="1" Content="{Binding [Profile.Enabled], Source={l:Lang}}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="Sections" AutomationProperties.AutomationId="ProfileSections" SelectionChanged="Section_Changed">
                <ListBoxItem Content="{Binding [Profile.PageGeneral], Source={l:Lang}}" IsSelected="True" />
                <ListBoxItem Content="{Binding [Profile.PageCompare], Source={l:Lang}}" />
                <ListBoxItem Content="{Binding [Profile.PageFilters], Source={l:Lang}}" />
                <ListBoxItem Content="{Binding [Profile.PageSync], Source={l:Lang}}" />
                <ListBoxItem Content="{Binding [Profile.PageVersioning], Source={l:Lang}}" />
                <ListBoxItem Content="{Binding [Profile.PagePerformance], Source={l:Lang}}" />
            </ListBox>

            <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="GeneralPage">
                        <TextBlock Text="{Binding [Profile.Name], Source={l:Lang}}" />
                        <TextBox x:Name="NameBox" AutomationProperties.AutomationId="ProfileName" Margin="0,3,0,10" />
                        <TextBlock Text="{Binding [Profile.Description], Source={l:Lang}}" />
                        <TextBox x:Name="DescriptionBox" AutomationProperties.AutomationId="ProfileDescription" Margin="0,3,0,10" />
                        <TextBlock Text="{Binding [Profile.LeftEndpoint], Source={l:Lang}}" />
                        <DockPanel Margin="0,3,0,10">
                            <Button DockPanel.Dock="Right" Content="{Binding [Profile.Test], Source={l:Lang}}" AutomationProperties.AutomationId="ProfileTestLeft" AutomationProperties.Name="{Binding [Profile.TestLeft], Source={l:Lang}}" Click="TestLeft_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="{Binding [Profile.Browse], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.BrowseLeft], Source={l:Lang}}" Click="BrowseLeft_Click" Style="{StaticResource TertiaryButtonStyle}" Margin="8,0,0,0" />
                            <TextBox x:Name="LeftPathBox" AutomationProperties.AutomationId="ProfileLeftPath" />
                        </DockPanel>
                        <TextBlock Text="{Binding [Profile.RightEndpoint], Source={l:Lang}}" />
                        <DockPanel Margin="0,3,0,10">
                            <Button DockPanel.Dock="Right" Content="{Binding [Profile.Test], Source={l:Lang}}" AutomationProperties.AutomationId="ProfileTestRight" AutomationProperties.Name="{Binding [Profile.TestRight], Source={l:Lang}}" Click="TestRight_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="{Binding [Profile.Browse], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.BrowseRight], Source={l:Lang}}" Click="BrowseRight_Click" Style="{StaticResource TertiaryButtonStyle}" Margin="8,0,0,0" />
                            <TextBox x:Name="RightPathBox" AutomationProperties.AutomationId="ProfileRightPath" />
                        </DockPanel>
                        <Button Content="{Binding [Profile.SwapEndpoints], Source={l:Lang}}" AutomationProperties.AutomationId="ProfileSwapEndpoints" AutomationProperties.Name="{Binding [Profile.SwapEndpoints], Source={l:Lang}}" HorizontalAlignment="Left" Click="SwapEndpoints_Click" Style="{StaticResource TertiaryButtonStyle}" />
                        <TextBlock x:Name="EndpointTestResult" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="ComparisonPage" Visibility="Collapsed">
                        <TextBlock Text="{Binding [Profile.PageCompare], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding [Profile.TimeTolerance], Source={l:Lang}}" Margin="0,14,0,2" />
                        <TextBox x:Name="TimeToleranceBox" Width="90" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding [Profile.TimeToleranceHint], Source={l:Lang}}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="FilterPage" Visibility="Collapsed">
                        <TextBlock Text="{Binding [Profile.FilterRules], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding [Profile.FilterRulesHint], Source={l:Lang}}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{Binding [Profile.AddInclude], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.AddIncludeRule], Source={l:Lang}}" Click="AddIncludeRule_Click" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{Binding [Profile.AddExclude], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.AddExcludeRule], Source={l:Lang}}" Click="AddExcludeRule_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
                            <Button Content="{Binding [Profile.CommonExcludes], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.AddCommonExcludes], Source={l:Lang}}" Click="ApplyCommonExcludes_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" />
                            <Button Content="{Binding [Profile.MoveUp], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.MoveUpRule], Source={l:Lang}}" Click="MoveRuleUp_Click" Style="{StaticResource TertiaryButtonStyle}" Margin="18,0,0,0" />
                            <Button Content="{Binding [Profile.MoveDown], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.MoveDownRule], Source={l:Lang}}" Click="MoveRuleDown_Click" Style="{StaticResource TertiaryButtonStyle}" Margin="6,0,0,0" />
                            <Button Content="{Binding [Profile.Delete], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.DeleteRule], Source={l:Lang}}" Click="RemoveRule_Click" Style="{StaticResource DangerButtonStyle}" Margin="6,0,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="185" SelectionChanged="RuleGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{Binding [Profile.RuleEnabled], Source={l:Lang}}" Binding="{Binding Enabled}" Width="52" />
                                <DataGridTextColumn Header="{Binding [Profile.RuleKind], Source={l:Lang}}" Binding="{Binding Kind}" IsReadOnly="True" Width="55" />
                                <DataGridTextColumn Header="{Binding [Profile.RulePattern], Source={l:Lang}}" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="{Binding [Profile.RuleComment], Source={l:Lang}}" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="8" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding [Profile.RuleAttributes], Source={l:Lang}}" FontWeight="Bold" />
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock Text="{Binding [Profile.MinBytes], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="RuleMinSizeBox" Width="80" Margin="4,0,10,0" />
                                    <TextBlock Text="{Binding [Profile.MaxBytes], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="RuleMaxSizeBox" Width="80" Margin="4,0,10,0" />
                                    <TextBlock Text="{Binding [Profile.ModifiedAfter], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="RuleAfterBox" Width="130" Margin="4,0,10,0" />
                                    <TextBlock Text="{Binding [Profile.ModifiedBefore], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="RuleBeforeBox" Width="130" Margin="4,0,10,0" />
                                </WrapPanel>
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="RuleHiddenBox" Content="{Binding [Profile.OnlyHidden], Source={l:Lang}}" />
                                    <CheckBox x:Name="RuleSymlinkBox" Content="{Binding [Profile.OnlySymlink], Source={l:Lang}}" Margin="14,0,0,0" />
                                    <Button Content="{Binding [Profile.ApplyAttributes], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.ApplyRuleAttributes], Source={l:Lang}}" Click="ApplyRuleAttributes_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="14,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding [Profile.FilterTester], Source={l:Lang}}" FontWeight="Bold" />
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBox x:Name="FilterTestPathBox" Width="230" ToolTip="{Binding [Profile.TestPathHint], Source={l:Lang}}" />
                                    <TextBox x:Name="FilterTestSizeBox" Width="80" Margin="6,0,0,0" ToolTip="{Binding [Profile.TestSizeHint], Source={l:Lang}}" />
                                    <CheckBox x:Name="FilterTestHiddenBox" Content="{Binding [Profile.Hidden], Source={l:Lang}}" Margin="8,0,0,0" />
                                    <CheckBox x:Name="FilterTestSymlinkBox" Content="{Binding [Profile.SymbolicLink], Source={l:Lang}}" Margin="8,0,0,0" />
                                    <Button Content="{Binding [Profile.Test], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.TestFilter], Source={l:Lang}}" Click="TestFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                                </WrapPanel>
                                <TextBlock x:Name="FilterTestResult" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SyncPage" Visibility="Collapsed">
                        <TextBlock Text="{Binding [Profile.SyncMode], Source={l:Lang}}" />
                        <ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="0,3,0,10">
                            <ComboBoxItem Content="{Binding [Profile.ModeTwoWay], Source={l:Lang}, Mode=OneWay}" />
                            <ComboBoxItem Content="{Binding [Profile.ModeMirrorRight], Source={l:Lang}, Mode=OneWay}" />
                            <ComboBoxItem Content="{Binding [Profile.ModeUpdateRight], Source={l:Lang}, Mode=OneWay}" />
                            <ComboBoxItem Content="{Binding [Profile.ModeCustom], Source={l:Lang}, Mode=OneWay}" IsEnabled="False" ToolTip="{Binding [Profile.ModeCustomHint], Source={l:Lang}, Mode=OneWay}" />
                        </ComboBox>
                        <TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,12,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="VersioningPage" Visibility="Collapsed">
                        <TextBlock Text="{Binding [Profile.PageVersioning], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}" />
                        <ComboBox x:Name="VersioningBox" SelectedIndex="0" Margin="0,8,0,3">
                            <ComboBoxItem Content="{Binding [Profile.VersioningNone], Source={l:Lang}, Mode=OneWay}" />
                            <ComboBoxItem Content="{Binding [Profile.VersioningArchive], Source={l:Lang}, Mode=OneWay}" />
                            <ComboBoxItem Content="{Binding [Profile.VersioningRecycle], Source={l:Lang}, Mode=OneWay}" />
                        </ComboBox>
                        <TextBlock Text="{Binding [Profile.ArchiveDirectory], Source={l:Lang}}" Margin="0,8,0,2" />
                        <TextBox x:Name="ArchiveBox" Margin="0,3,0,8" ToolTip="{Binding [Profile.ArchiveDirectory], Source={l:Lang}}" />
                        <WrapPanel>
                            <TextBlock Text="{Binding [Profile.KeepDays], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="KeepDaysBox" Width="72" Margin="5,0,14,0" />
                            <TextBlock Text="{Binding [Profile.MaxVersions], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="MaxVersionsBox" Width="72" Margin="5,0,14,0" />
                            <TextBlock Text="{Binding [Profile.MaxTotalMb], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="MaxTotalMbBox" Width="92" Margin="5,0,0,0" />
                        </WrapPanel>
                        <TextBlock Text="{Binding [Profile.VersioningHint], Source={l:Lang}}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,6,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding [Profile.PreviewCleanup], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.PreviewArchiveCleanup], Source={l:Lang}}" Click="PreviewRetention_Click" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{Binding [Profile.CleanupNow], Source={l:Lang}}" AutomationProperties.Name="{Binding [Profile.CleanupArchiveNow], Source={l:Lang}}" Click="CleanupRetention_Click" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="RetentionResult" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PerformancePage" Visibility="Collapsed">
                        <CheckBox x:Name="UseDefaultCopies" Content="{Binding [Profile.UseDefaultCopies], Source={l:Lang}}" Checked="UseDefaultCopies_Changed" Unchecked="UseDefaultCopies_Changed" />
                        <CheckBox x:Name="VerifyCopies" Content="{Binding [Profile.VerifyCopies], Source={l:Lang}}" Margin="0,3,0,10" />
                        <CheckBox x:Name="UseDefaultConcurrency" AutomationProperties.AutomationId="ProfileUseDefaultConcurrency" Content="{Binding [Profile.UseDefaultConcurrency], Source={l:Lang}}" Checked="UseDefaultConcurrency_Changed" Unchecked="UseDefaultConcurrency_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10"><TextBlock Text="{Binding [Profile.MaxConcurrency], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="ConcurrencyBox" AutomationProperties.AutomationId="ProfileConcurrency" Width="60" /></StackPanel>
                        <CheckBox x:Name="UseDefaultResume" AutomationProperties.AutomationId="ProfileUseDefaultResume" Content="{Binding [Profile.UseDefaultResume], Source={l:Lang}}" Checked="UseDefaultResume_Changed" Unchecked="UseDefaultResume_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,2">
                            <TextBlock Text="{Binding [Profile.ResumeMinimum], Source={l:Lang}}" VerticalAlignment="Center" />
                            <TextBox x:Name="ResumeMinimumBox" AutomationProperties.AutomationId="ProfileResumeMinimum" Width="90" />
                        </StackPanel>
                        <TextBlock Text="{Binding [Profile.ResumeMinimumHint], Source={l:Lang}}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding [Profile.DeleteSafety], Source={l:Lang}}" FontWeight="Bold" Margin="0,12,0,3" />
                        <TextBlock Text="{Binding [Profile.DeleteSafetyHint], Source={l:Lang}}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding [Profile.MaxDeletes], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="MaxDeletesBox" AutomationProperties.AutomationId="ProfileMaxDeletes" Width="80" Margin="5,0,14,0" />
                            <TextBlock Text="{Binding [Profile.MaxDeleteRatio], Source={l:Lang}}" VerticalAlignment="Center" /><TextBox x:Name="MaxDeleteRatioBox" AutomationProperties.AutomationId="ProfileMaxDeleteRatio" Width="80" Margin="5,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button AutomationProperties.AutomationId="ProfileSaveAs" AutomationProperties.Name="{Binding [Profile.SaveAs], Source={l:Lang}}" Click="SaveAs_Click" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}"><TextBlock Text="{Binding [Profile.SaveAs], Source={l:Lang}}" /></Button>
                <Button AutomationProperties.AutomationId="ProfileSave" AutomationProperties.Name="{Binding [Profile.SaveAction], Source={l:Lang}}" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"><TextBlock Text="{Binding [Profile.Save], Source={l:Lang}}" /></Button>
                <Button AutomationProperties.AutomationId="ProfileCancel" AutomationProperties.Name="{Binding [Profile.CancelAction], Source={l:Lang}}" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource TertiaryButtonStyle}"><TextBlock Text="{Binding [Profile.Cancel], Source={l:Lang}}" /></Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
