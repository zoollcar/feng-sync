<Window x:Class="FengSync.Views.CloudEndpointOrganizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Organize.WindowTitle], Source={l:Lang}}"
        Width="480"
        Height="340"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="CloudEndpointOrganizationWindow"
        AutomationProperties.Name="{Binding [Organize.WindowName], Source={l:Lang}}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource DisplayTitleTextStyle}" />
            <TextBlock x:Name="SubHeaderText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{Binding [Organize.GroupLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="GroupTextBox"
                     AutomationProperties.AutomationId="EndpointGroupBox"
                     AutomationProperties.Name="{Binding [Organize.GroupName], Source={l:Lang}}" />
            <TextBlock x:Name="GroupHint"
                       AutomationProperties.AutomationId="EndpointGroupHint"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding [Organize.TagsLabel], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
            <TextBox x:Name="TagsBox"
                     AutomationProperties.AutomationId="EndpointTagsBox"
                     AutomationProperties.Name="{Binding [Organize.TagsName], Source={l:Lang}}" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"
                   Text="{Binding [Organize.Note], Source={l:Lang}}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton"
                    AutomationProperties.AutomationId="EndpointOrganizationOk"
                    AutomationProperties.Name="{Binding [Organize.SaveName], Source={l:Lang}}"
                    Content="{Binding [Organize.Save], Source={l:Lang}}"
                    IsDefault="True"
                    Click="Ok_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="{Binding [Organize.Cancel], Source={l:Lang}}"
                    AutomationProperties.AutomationId="EndpointOrganizationCancel"
                    AutomationProperties.Name="{Binding [Organize.CancelName], Source={l:Lang}}"
                    IsCancel="True"
                    Margin="8,0,0,0"
                    Style="{StaticResource TertiaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
