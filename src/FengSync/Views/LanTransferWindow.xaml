<Window x:Class="FengSync.Views.LanTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Lan.Title], Source={l:Lang}}"
        Width="1240"
        Height="820"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        AutomationProperties.AutomationId="LanTransferWindow"
        AutomationProperties.Name="{Binding [Lan.WindowName], Source={l:Lang}}">
    <Window.Resources>
        <!-- One bubble shape for both sides of the room; which side a row sits on is the row's own answer, and
             the fill is the only thing that differs, so the two cannot drift into different paddings. -->
        <Style x:Key="ChatBubbleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NeutralSubtleBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 底部状态行：整个窗口只有一句话的空间来报告启动失败、端口被占、防火墙被取消这类事实。 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <DockPanel LastChildFill="True">
                <fluent:FluentIcon DockPanel.Dock="Left" Icon="Info" Width="16" Height="16" FontSize="16"
                                   Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Style="{StaticResource LibraryIconStyle}"/>
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="LanStatusText"
                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ================= 顶部：这台电脑叫什么，以及收到东西时怎么办 =================
             改名、自动接收、接收目录、端口和防火墙都放在这一条里：它们都是关于这台机器现在的做法，
             而不是关于房间里某一句话。房间里的内容往下走。 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <WrapPanel>
                <TextBlock Text="{Binding [Lan.MyDevice], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="DeviceNameBox" AutomationProperties.AutomationId="LanDeviceNameBox"
                         Width="168" Margin="6,0,0,0" VerticalContentAlignment="Center"
                         MaxLength="32"/>
                <Button x:Name="SaveDeviceNameButton" AutomationProperties.AutomationId="LanSaveDeviceNameButton"
                        Content="{Binding [Lan.SaveName], Source={l:Lang}}" Click="SaveDeviceName_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/>

                <CheckBox x:Name="AutoReceiveBox" AutomationProperties.AutomationId="LanAutoReceiveBox"
                          Content="{Binding [Lan.AutoReceive], Source={l:Lang}}" Margin="18,0,0,0"
                          VerticalAlignment="Center" Checked="AutoReceive_Changed" Unchecked="AutoReceive_Changed"/>

                <TextBlock Text="{Binding [Lan.ReceiveDirectory], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"
                           Margin="18,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ReceiveDirectoryText" AutomationProperties.AutomationId="LanReceiveDirectory"
                           Style="{StaticResource CaptionTextStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                           MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="PickDirectoryButton" AutomationProperties.AutomationId="LanPickDirectoryButton"
                        Content="{Binding [Lan.ChooseDirectory], Source={l:Lang}}" Click="PickDirectory_Click"
                        Style="{StaticResource TertiaryButtonStyle}" Margin="6,0,0,0"/>

                <TextBlock Text="{Binding [Lan.Port], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"
                           Margin="18,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="PortBox" AutomationProperties.AutomationId="LanPortBox" Width="64"
                         Margin="6,0,0,0" VerticalContentAlignment="Center"/>
                <Button x:Name="ApplyPortButton" AutomationProperties.AutomationId="LanApplyPortButton"
                        Content="{Binding [Lan.ApplyPort], Source={l:Lang}}" Click="ApplyPort_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/>

                <Button x:Name="FirewallButton" AutomationProperties.AutomationId="LanFirewallButton"
                        Content="{Binding [Lan.FirewallAdd], Source={l:Lang}}" Click="Firewall_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="18,0,0,0"/>
                <TextBlock x:Name="FirewallStatusText" AutomationProperties.AutomationId="LanFirewallStatus"
                           Style="{StaticResource CaptionTextStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                           MaxWidth="220" TextTrimming="CharacterEllipsis"/>
            </WrapPanel>
        </Border>

        <Grid Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="392"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 房间 ================= -->
            <Border Grid.Column="0" Background="{DynamicResource AppCanvasBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}">
                <DockPanel LastChildFill="True">

                    <!-- 陌生设备的第一笔要在这里点「同意」，所以这一栏在没有待确认项时整块收起：
                         一个没人能按的按钮组比空白更让人怀疑是不是坏了。 -->
                    <Border DockPanel.Dock="Top" x:Name="PendingBorder"
                            Background="{DynamicResource WarningSubtleBackgroundBrush}"
                            CornerRadius="{StaticResource RadiusMedium}" Padding="10" Margin="12,12,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Lan.Pending], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"/>
                            <TextBlock Text="{Binding [Lan.PendingHint], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="AcceptPendingButton" AutomationProperties.AutomationId="LanAcceptPendingButton"
                                            Content="{Binding [Lan.Accept], Source={l:Lang}}" Click="AcceptPending_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Button x:Name="DeclinePendingButton" AutomationProperties.AutomationId="LanDeclinePendingButton"
                                            Content="{Binding [Lan.Decline], Source={l:Lang}}" Click="DeclinePending_Click"
                                            Style="{StaticResource TertiaryButtonStyle}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <ListView x:Name="PendingList" AutomationProperties.AutomationId="LanPendingList"
                                          BorderThickness="0" Background="Transparent" MaxHeight="120"
                                          SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextStyle}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 正在进出的字节。对方推过来的文件在落地之前没有气泡可挂，所以这一条是它唯一的可见性；
                         自己在拉的则在房间的气泡里画进度。没有在跑的传输时整条收起。 -->
                    <Border DockPanel.Dock="Top" x:Name="TransferBorder"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="10,8" Margin="12,10,12,0" CornerRadius="{StaticResource RadiusMedium}">
                        <ListView x:Name="TransferList" AutomationProperties.AutomationId="LanTransferList"
                                  BorderThickness="0" Background="Transparent" MaxHeight="120"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Line}" Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Mode=OneWay is load-bearing here for the same reason it is in the
                                             bubble template: LanProgressRow.Percentage is read-only. -->
                                        <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                     Value="{Binding Percentage, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsUnknown}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- 输入区。回车发送、Shift+回车换行：聊天框里的人默认按回车。 -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            Padding="12,10">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="AddFilesButton" AutomationProperties.AutomationId="LanAddFilesButton"
                                        Content="{Binding [Lan.SendFiles], Source={l:Lang}}" Click="AddFiles_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button x:Name="AddFolderButton" AutomationProperties.AutomationId="LanAddFolderButton"
                                        Content="{Binding [Lan.SendFolder], Source={l:Lang}}" Click="AddFolder_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/>
                                <Button x:Name="SendButton" AutomationProperties.AutomationId="LanSendButton"
                                        Content="{Binding [Lan.Send], Source={l:Lang}}" Click="Send_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="ChatInputBox" AutomationProperties.AutomationId="LanChatInput"
                                     AcceptsReturn="True" MaxLines="4" TextWrapping="Wrap"
                                     MinHeight="30" MaxHeight="88" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Center" KeyDown="Message_KeyDown"/>
                        </DockPanel>
                    </Border>

                    <Grid Margin="12,0">
                        <ListView x:Name="ChatList" AutomationProperties.AutomationId="LanChatList"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <!-- A chat row is not selectable: the only thing on it anybody clicks is 接收. -->
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationLine}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- 房间里的旁白（谁进来了、谁改名了）不属于任何一边，所以居中且不进气泡。 -->
                                        <TextBlock Text="{Binding SystemText}" Visibility="{Binding SystemVisibility}"
                                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="8,2"/>
                                        <Border Style="{StaticResource ChatBubbleBorderStyle}"
                                                Visibility="{Binding BubbleVisibility}"
                                                HorizontalAlignment="{Binding Side}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AuthorLine}" Visibility="{Binding AuthorVisibility}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Body}" Style="{StaticResource BodyTextStyle}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <!-- Mode=OneWay is load-bearing: RangeBase.Value binds TwoWay by
                                                     default and LanChatRow.Percentage is read-only, so the default
                                                     mode throws a XamlParseException the first time a pulling row is
                                                     realised — in a window the user is already looking at. -->
                                                <ProgressBar Height="4" Minimum="0" Maximum="100" Margin="0,4,0,0"
                                                             Visibility="{Binding ProgressVisibility}"
                                                             Value="{Binding Percentage, Mode=OneWay}"
                                                             IsIndeterminate="{Binding IsUnknown}"/>
                                                <Button Content="{Binding [Lan.Receive], Source={l:Lang}}" Click="Receive_Click" Tag="{Binding}"
                                                        Visibility="{Binding ActionVisibility}" Margin="0,6,0,0"
                                                        HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                                        AutomationProperties.AutomationId="LanReceiveButton"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ChatEmptyText" AutomationProperties.AutomationId="LanChatEmpty"
                                   Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="{Binding [Lan.RoomEmpty], Source={l:Lang}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderSubtleBrush}"/>

            <!-- ================= 这个群里的设备 ================= -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [Lan.Pairing], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding [Lan.PairingHint], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <Border Margin="0,12,0,0" Background="White" CornerRadius="{StaticResource RadiusMedium}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="6"
                                HorizontalAlignment="Center">
                            <Image x:Name="QrImage" AutomationProperties.AutomationId="LanQrImage"
                                   Width="164" Height="164" Stretch="Uniform"/>
                        </Border>

                        <TextBlock x:Name="PairCodeText" AutomationProperties.AutomationId="LanPairCode"
                                   Style="{StaticResource DisplayTitleTextStyle}" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="PairRemainingText" AutomationProperties.AutomationId="LanPairRemaining"
                                   Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <Button x:Name="RegenerateButton" AutomationProperties.AutomationId="LanRegenerateButton"
                                Content="{Binding [Lan.Regenerate], Source={l:Lang}}" Click="Regenerate_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding [Lan.Addresses], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"
                                   Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding [Lan.AddressPickHint], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <ListBox x:Name="AddressList" AutomationProperties.AutomationId="LanAddressList"
                                 SelectionChanged="AddressList_SelectionChanged" MaxHeight="88"/>

                        <TextBlock Text="{Binding [Lan.PortHint], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding [Lan.Members], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="0,16,0,0"/>
                        <ListView x:Name="TrustedList" AutomationProperties.AutomationId="LanTrustedList"
                                  BorderThickness="0" Background="Transparent" MaxHeight="176"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="{Binding [Lan.Forget], Source={l:Lang}}"
                                                AutomationProperties.AutomationId="LanForgetPeerButton"
                                                Style="{StaticResource TertiaryButtonStyle}"
                                                Click="ForgetPeer_Click" Tag="{Binding}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextStyle}"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="TrustedEmptyText" AutomationProperties.AutomationId="LanTrustedEmpty"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="{Binding [Lan.NoTrustedDevices], Source={l:Lang}}"/>

                        <TextBlock Text="{Binding [Lan.Computers], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"
                                   Margin="0,16,0,0"/>
                        <ListView x:Name="DiscoveredList" AutomationProperties.AutomationId="LanDiscoveredList"
                                  BorderThickness="0" Background="Transparent" MaxHeight="112"
                                  SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextStyle}"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="DiscoveredEmptyText" AutomationProperties.AutomationId="LanDiscoveredEmpty"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="{Binding [Lan.NoComputersFound], Source={l:Lang}}"/>

                        <!-- 手动地址在界面上一直可达：AP 隔离之类的网络拦得住发现也拦得住连接，这里没有软件解法。 -->
                        <TextBlock Text="{Binding [Lan.ManualPeer], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"
                                   Margin="0,12,0,0"/>
                        <TextBox x:Name="PeerAddressBox" AutomationProperties.AutomationId="LanPeerAddressBox"
                                 Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding [Lan.ManualPeerHint], Source={l:Lang}}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBox x:Name="PeerCodeBox" AutomationProperties.AutomationId="LanPeerCodeBox"
                                 Margin="0,6,0,0" MaxLength="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="CheckPeerButton" AutomationProperties.AutomationId="LanCheckPeerButton"
                                    Content="{Binding [Lan.CheckPeer], Source={l:Lang}}" Click="CheckPeer_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button x:Name="PairPeerButton" AutomationProperties.AutomationId="LanPairPeerButton"
                                    Content="{Binding [Lan.PairPeer], Source={l:Lang}}" Click="PairPeer_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="PeerStatusText" AutomationProperties.AutomationId="LanPeerStatus"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock Text="{Binding [Lan.History], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}"
                                   Margin="0,16,0,0"/>
                        <ListView x:Name="HistoryList" AutomationProperties.AutomationId="LanHistoryList"
                                  BorderThickness="0" Background="Transparent" MaxHeight="150"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="HistoryEmptyText" AutomationProperties.AutomationId="LanHistoryEmpty"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="{Binding [Lan.NoHistory], Source={l:Lang}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>