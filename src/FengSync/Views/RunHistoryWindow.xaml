<Window x:Class="FengSync.Views.RunHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行历史"
        Width="1050"
        MinWidth="900"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.AutomationId="RunHistoryWindow"
        AutomationProperties.Name="运行历史">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Text="运行历史" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="查看每次同步的结果与传输摘要。"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,14" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="结果：" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                    <ComboBox x:Name="OutcomeBox"
                              AutomationProperties.AutomationId="RunHistoryOutcome"
                              AutomationProperties.Name="按结果筛选运行历史"
                              Width="130"
                              SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="全部" IsSelected="True" />
                        <ComboBoxItem Content="成功" />
                        <ComboBoxItem Content="部分成功" />
                        <ComboBoxItem Content="失败" />
                        <ComboBoxItem Content="已取消" />
                    </ComboBox>
                    <TextBlock Text="最近："
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                    <ComboBox x:Name="PeriodBox"
                              AutomationProperties.AutomationId="RunHistoryPeriod"
                              AutomationProperties.Name="按时间范围筛选运行历史"
                              Width="120"
                              SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="全部" IsSelected="True" />
                        <ComboBoxItem Content="7 天" />
                        <ComboBoxItem Content="30 天" />
                    </ComboBox>
                    <Button x:Name="RefreshButton"
                            AutomationProperties.AutomationId="RefreshRunHistory"
                            AutomationProperties.Name="刷新运行历史"
                            Click="Refresh_Click"
                            Margin="12,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}">刷新</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  x:Name="Entries"
                  AutomationProperties.AutomationId="RunHistoryEntries"
                  AutomationProperties.Name="运行历史记录"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="24,18">
            <DataGrid.Columns>
                <DataGridTextColumn Header="完成时间" Binding="{Binding CompletedLocalText}" Width="145" />
                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileId}" Width="130" />
                <DataGridTextColumn Header="结果" Binding="{Binding OutcomeText}" Width="80" />
                <DataGridTextColumn Header="计划" Binding="{Binding Planned}" Width="60" />
                <DataGridTextColumn Header="成功" Binding="{Binding Succeeded}" Width="60" />
                <DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="60" />
                <DataGridTextColumn Header="字节" Binding="{Binding TransferredText}" Width="85" />
                <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="2*" />
                <DataGridTextColumn Header="类别" Binding="{Binding FailureCategory}" Width="100" />
                <DataGridTextColumn Header="可重试" Binding="{Binding FailureRetryable}" Width="70" />
                <DataGridTextColumn Header="诊断 ID" Binding="{Binding CorrelationId}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
