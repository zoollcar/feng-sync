<Window x:Class="FengSync.Views.RunHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Run.WindowTitle], Source={l:Lang}}"
        Width="1050"
        MinWidth="900"
        Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.AutomationId="RunHistoryWindow"
        AutomationProperties.Name="{Binding [Run.WindowTitle], Source={l:Lang}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel>
                <TextBlock Text="{Binding [Run.WindowTitle], Source={l:Lang}}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{Binding [Run.Intro], Source={l:Lang}}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,14" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding [Run.OutcomeLabel], Source={l:Lang}}" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                    <ComboBox x:Name="OutcomeBox"
                              AutomationProperties.AutomationId="RunHistoryOutcome"
                              AutomationProperties.Name="{Binding [Run.FilterByOutcome], Source={l:Lang}}"
                              Width="130"
                              SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="{Binding [Run.All], Source={l:Lang}, Mode=OneWay}" IsSelected="True" />
                        <ComboBoxItem Content="{Binding [Run.OutcomeSucceeded], Source={l:Lang}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding [Run.OutcomePartial], Source={l:Lang}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding [Run.OutcomeFailed], Source={l:Lang}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding [Run.OutcomeCancelled], Source={l:Lang}, Mode=OneWay}" />
                    </ComboBox>
                    <TextBlock Text="{Binding [Run.RecentLabel], Source={l:Lang}}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource BodyTextStyle}" />
                    <ComboBox x:Name="PeriodBox"
                              AutomationProperties.AutomationId="RunHistoryPeriod"
                              AutomationProperties.Name="{Binding [Run.FilterByPeriod], Source={l:Lang}}"
                              Width="120"
                              SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="{Binding [Run.All], Source={l:Lang}, Mode=OneWay}" IsSelected="True" />
                        <ComboBoxItem Content="{Binding [Run.Last7Days], Source={l:Lang}, Mode=OneWay}" />
                        <ComboBoxItem Content="{Binding [Run.Last30Days], Source={l:Lang}, Mode=OneWay}" />
                    </ComboBox>
                    <Button x:Name="RefreshButton"
                            AutomationProperties.AutomationId="RefreshRunHistory"
                            AutomationProperties.Name="{Binding [Run.Refresh], Source={l:Lang}}"
                            Click="Refresh_Click"
                            Margin="12,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Content="{Binding [Run.Refresh], Source={l:Lang}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  x:Name="Entries"
                  AutomationProperties.AutomationId="RunHistoryEntries"
                  AutomationProperties.Name="{Binding [Run.EntryList], Source={l:Lang}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="24,18">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [Run.ColCompleted], Source={l:Lang}}" Binding="{Binding CompletedLocalText}" Width="145" />
                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileId}" Width="130" />
                <DataGridTextColumn Header="{Binding [Run.ColOutcome], Source={l:Lang}}" Binding="{Binding OutcomeText}" Width="80" />
                <DataGridTextColumn Header="{Binding [Run.ColPlanned], Source={l:Lang}}" Binding="{Binding Planned}" Width="60" />
                <DataGridTextColumn Header="{Binding [Run.ColSucceeded], Source={l:Lang}}" Binding="{Binding Succeeded}" Width="60" />
                <DataGridTextColumn Header="{Binding [Run.ColFailed], Source={l:Lang}}" Binding="{Binding Failed}" Width="60" />
                <DataGridTextColumn Header="{Binding [Run.ColBytes], Source={l:Lang}}" Binding="{Binding TransferredText}" Width="85" />
                <DataGridTextColumn Header="{Binding [Run.ColDetail], Source={l:Lang}}" Binding="{Binding Detail}" Width="2*" />
                <DataGridTextColumn Header="{Binding [Run.ColCategory], Source={l:Lang}}" Binding="{Binding FailureCategory}" Width="100" />
                <DataGridTextColumn Header="{Binding [Run.ColRetryable], Source={l:Lang}}" Binding="{Binding FailureRetryable}" Width="70" />
                <DataGridTextColumn Header="{Binding [Run.ColCorrelationId], Source={l:Lang}}" Binding="{Binding CorrelationId}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
