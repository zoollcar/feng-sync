<Window x:Class="FengSync.Views.SyncConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="确认同步操作" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="执行前请核对以下受影响范围。" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1" Padding="14" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CopyText"/><TextBlock x:Name="OverwriteText" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="DeleteText"/><TextBlock x:Name="TransferText" Margin="0,5,0,0"/></StackPanel></Grid></Border>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="SpaceText" AutomationProperties.AutomationId="SyncSpaceSummary" TextWrapping="Wrap"/><TextBlock x:Name="IssuesText" AutomationProperties.AutomationId="SyncIssues" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><StackPanel x:Name="ProfileConfirmationPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock x:Name="ProfileConfirmationPrompt" TextWrapping="Wrap"/><TextBox x:Name="ProfileNameInput" AutomationProperties.AutomationId="ProfileNameInput" Margin="0,5,0,0"/></StackPanel></StackPanel>
 </Grid><Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="返回设置" AutomationProperties.AutomationId="CancelSyncButton" IsCancel="True" Margin="0,0,8,0" Style="{StaticResource GhostButtonStyle}"/><Button x:Name="ConfirmButton" AutomationProperties.AutomationId="ConfirmSyncButton" Content="确认同步" IsDefault="True" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border></Grid>
</Window>
