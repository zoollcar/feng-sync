<Window x:Class="FengSync.Views.SyncConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Sync.WindowTitle], Source={l:Lang}}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppCanvasBrush}"
        AutomationProperties.AutomationId="SyncConfirmationWindow"
        AutomationProperties.Name="{Binding [Sync.WindowTitle], Source={l:Lang}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource DisplayTitleTextStyle}" />
                <TextBlock Text="{Binding [Sync.CheckBeforeRun], Source={l:Lang}}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Padding="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    AutomationProperties.Name="{Binding [Sync.SummaryCallout], Source={l:Lang}}">
                <StackPanel>
                    <TextBlock Text="{Binding [Sync.SummaryTitle], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CopyText" Style="{StaticResource ChangeSummaryItemTextStyle}" />
                        <TextBlock x:Name="OverwriteText" Grid.Row="1" Style="{StaticResource ChangeSummaryItemTextStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="DeleteText" Grid.Column="1" Style="{StaticResource ChangeSummaryItemTextStyle}" />
                        <TextBlock x:Name="TransferText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ChangeSummaryItemTextStyle}" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Border Style="{StaticResource SafetyCalloutStyle}"
                        AutomationProperties.AutomationId="SyncSpaceCallout"
                        AutomationProperties.Name="{Binding [Sync.SpaceCheck], Source={l:Lang}}">
                    <TextBlock x:Name="SpaceText"
                               AutomationProperties.AutomationId="SyncSpaceSummary"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap" />
                </Border>

                <Border x:Name="IssuesCallout"
                        Visibility="Collapsed"
                        Style="{StaticResource SafetyCalloutDangerStyle}"
                        Margin="0,12,0,0"
                        AutomationProperties.AutomationId="SyncIssuesCallout"
                        AutomationProperties.Name="{Binding [Sync.IssuesCallout], Source={l:Lang}}"
                        AutomationProperties.LiveSetting="Assertive">
                    <StackPanel>
                        <TextBlock Text="{Binding [Sync.CannotStartSafely], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock x:Name="IssuesText"
                                   AutomationProperties.AutomationId="SyncIssues"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="ProfileConfirmationPanel"
                        Visibility="Collapsed"
                        Style="{StaticResource SafetyCalloutWarningStyle}"
                        Margin="0,12,0,0"
                        AutomationProperties.AutomationId="ProfileConfirmationCallout"
                        AutomationProperties.Name="{Binding [Sync.NeedProfileName], Source={l:Lang}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [Sync.NeedExplicitConfirm], Source={l:Lang}}" Style="{StaticResource BodyStrongTextStyle}" />
                        <TextBlock x:Name="ProfileConfirmationPrompt"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="ProfileNameInput"
                                 AutomationProperties.AutomationId="ProfileNameInput"
                                 AutomationProperties.Name="{Binding [Sync.ProfileNameLabel], Source={l:Lang}}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ProfileConfirmationPrompt}"
                                 Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [Sync.BackToSettings], Source={l:Lang}}"
                        AutomationProperties.AutomationId="CancelSyncButton"
                        AutomationProperties.Name="{Binding [Sync.BackToSettingsName], Source={l:Lang}}"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Style="{StaticResource TertiaryButtonStyle}" />
                <Button x:Name="ConfirmButton"
                        AutomationProperties.AutomationId="ConfirmSyncButton"
                        AutomationProperties.Name="{Binding [Sync.ConfirmName], Source={l:Lang}}"
                        Content="{Binding [Sync.Confirm], Source={l:Lang}}"
                        IsDefault="True"
                        Click="Confirm_Click"
                        Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
