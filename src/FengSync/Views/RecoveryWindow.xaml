<Window x:Class="FengSync.Views.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="需要恢复的同步" Width="760" Height="440" WindowStartupLocation="CenterOwner">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="检测到未完成的同步或基线事务" FontSize="19" FontWeight="Bold"/><TextBlock Text="正式基线不会因此自动变更。请查看详情；可安全清理本地临时文件，然后重新比较再继续同步。" TextWrapping="Wrap" Foreground="#52606D" Margin="0,5,0,12"/></StackPanel>
  <DataGrid x:Name="Items" AutomationProperties.AutomationId="RecoveryItems" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Items_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="时间" Binding="{Binding When, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="175"/><DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="Status" AutomationProperties.AutomationId="RecoveryStatus" VerticalAlignment="Center" Foreground="#52606D"/><Button Content="安全清理本地临时文件" AutomationProperties.AutomationId="RecoveryCleanup" Click="Cleanup_Click" Padding="12,6" DockPanel.Dock="Right"/><Button Content="关闭" AutomationProperties.AutomationId="RecoveryClose" IsDefault="True" Click="Close_Click" Padding="20,6" Margin="8,0,0,0" DockPanel.Dock="Right"/></DockPanel>
 </Grid>
</Window>
