<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Documented font fallback chain -->
 <FontFamily x:Key="DefaultFontFamily">Segoe UI, Microsoft YaHei UI, Segoe UI Variable, sans-serif</FontFamily>
 <!-- Existing text styles preserved; font fallback applied for parity with documented chain -->
 <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
  <Setter Property="FontSize" Value="20"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
 <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
  <Setter Property="FontSize" Value="16"/>
  <Setter Property="LineHeight" Value="22"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
 <Style x:Key="BodyTextStyle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="LineHeight" Value="20"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
 <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="LineHeight" Value="20"/>
  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
 </Style>
 <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
 </Style>
 <Style x:Key="DataGridHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
 <!-- Documented typography styles (consumable by later MainWindow work) -->
 <Style x:Key="DisplayTitleTextStyle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
  <Setter Property="FontSize" Value="22"/>
  <Setter Property="LineHeight" Value="28"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
 <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
  <Setter Property="LineHeight" Value="20"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
 <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="LineHeight" Value="20"/>
  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
 </Style>
 <Style x:Key="MetricTextStyle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
  <Setter Property="FontSize" Value="20"/>
  <Setter Property="LineHeight" Value="26"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
 </Style>
</ResourceDictionary>
