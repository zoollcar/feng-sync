<Window x:Class="FengSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Feng Sync - 文件夹对比和同步" Height="780" Width="1360" MinHeight="620" MinWidth="1050" Background="#F5F5F5" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="PanelLine" Color="#AEB6BE"/><SolidColorBrush x:Key="BlueHeader" Color="#147AC2"/><SolidColorBrush x:Key="Green" Color="#159447"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#F7F7F7"/><Setter Property="BorderBrush" Value="#BFC7CF"/></Style>
  <Style x:Key="Tool" TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#F4F4F4"/><Setter Property="BorderBrush" Value="#C0C6CC"/></Style>
  <Style x:Key="BlueTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Height="27" Background="White" BorderBrush="{StaticResource PanelLine}" BorderThickness="0,0,0,1" Padding="7,2"><StackPanel Orientation="Horizontal"><TextBlock Text="文件" Margin="0,0,22,0"/><TextBlock Text="操作" Margin="0,0,22,0"/><TextBlock Text="工具" Margin="0,0,22,0"/><TextBlock Text="帮助"/><TextBlock Text=" ★ Feng Sync 预览版" Foreground="#0064B2" Margin="25,0,0,0"/></StackPanel></Border>
  <Border DockPanel.Dock="Top" Height="78" Background="#F8F8F8" BorderBrush="{StaticResource PanelLine}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Style="{StaticResource Tool}" Click="NewProfile_Click" ToolTip="新建配置"><StackPanel><TextBlock Text="✚" Foreground="#12A24A" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="新建"/></StackPanel></Button><Button Style="{StaticResource Tool}" Click="LoadProfile_Click" ToolTip="打开配置"><StackPanel><TextBlock Text="▣" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="打开"/></StackPanel></Button><Button Style="{StaticResource Tool}" Click="SaveProfile_Click" ToolTip="保存配置"><StackPanel><TextBlock Text="▣" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="保存"/></StackPanel></Button><Button Style="{StaticResource Tool}" Click="RunProfile_Click" ToolTip="批处理"><StackPanel><TextBlock Text="▶" Foreground="#159447" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="批处理"/></StackPanel></Button></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="CompareButton" Click="Compare_Click" Style="{StaticResource Tool}" MinWidth="190"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="30" Margin="0,0,10,0"/><StackPanel><TextBlock Text="比较" FontSize="19" FontWeight="Bold"/><TextBlock Text="文件时间和大小" Foreground="#53606B"/></StackPanel></StackPanel></Button><ComboBox x:Name="SyncModeBox" Width="104" Height="31" Margin="4" SelectedIndex="0" SelectionChanged="SyncMode_Changed"><ComboBoxItem Content="双向 ↔"/><ComboBoxItem Content="镜像 →"/><ComboBoxItem Content="更新 →"/><ComboBoxItem Content="自定义 →"/></ComboBox><Button Click="ToggleSettings_Click" Style="{StaticResource Tool}" ToolTip="比较设置"><TextBlock Text="⚙" FontSize="27" Foreground="#378CC6"/></Button><Button Click="KeepLeft_Click" Style="{StaticResource Tool}" ToolTip="冲突：保留左侧"><TextBlock Text="←" FontSize="24"/></Button><Button Click="KeepRight_Click" Style="{StaticResource Tool}" ToolTip="冲突：保留右侧"><TextBlock Text="→" FontSize="24"/></Button><Button x:Name="SyncButton" Click="Sync_Click" IsEnabled="False" Style="{StaticResource Tool}" Background="#DDF4D8" BorderBrush="#8EBA89" MinWidth="205"><StackPanel Orientation="Horizontal"><TextBlock Text="⟳" FontSize="30" Foreground="#159447" Margin="0,0,8,0"/><StackPanel><TextBlock Text="同步" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="SyncModeCaption" Text="双向 ↔" Foreground="#53606B"/></StackPanel></StackPanel></Button></StackPanel>
  </Grid></Border>
  <Border DockPanel.Dock="Bottom" Background="#F8F8F8" BorderBrush="{StaticResource PanelLine}" BorderThickness="0,1,0,0" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Grid.Column="1" Foreground="#4A5863" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="统计："/><TextBlock x:Name="SelectedLabel" FontWeight="Bold"/><TextBlock Text=" 个已选  ·  并发 "/><TextBlock x:Name="ConcurrencyLabel" FontWeight="Bold"/></StackPanel></Grid></Border>
  <Grid x:Name="MainLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Background="White"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="55"/><RowDefinition Height="150"/><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource BlueHeader}" Padding="7,0"><DockPanel><TextBlock Text="Configuration" Style="{StaticResource BlueTitle}"/><Button DockPanel.Dock="Right" Click="ToggleSettings_Click" Background="Transparent" BorderThickness="0" Foreground="White" Padding="4" Content="×"/></DockPanel></Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button ToolTip="新建"><TextBlock Text="✚" Foreground="#12A24A" FontSize="22"/></Button><Button ToolTip="打开"><TextBlock Text="▣" FontSize="22"/></Button><Button Click="SaveSettings_Click" ToolTip="保存"><TextBlock Text="▣" FontSize="22"/></Button><Button ToolTip="批处理"><TextBlock Text="▶" FontSize="22" Background="Black" Foreground="White"/></Button></StackPanel>
    <ListBox x:Name="ProfileList" Grid.Row="2" BorderThickness="0" Margin="5" DisplayMemberPath="Name" SelectionChanged="ProfileList_SelectionChanged"/>
    <Border Grid.Row="3" Background="{StaticResource BlueHeader}" Padding="7,0"><TextBlock Text="Overview" Style="{StaticResource BlueTitle}"/></Border>
    <StackPanel Grid.Row="4" Margin="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><TextBlock Text="文件夹" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="项目" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="大小" FontWeight="Bold"/></Grid><Separator/><StackPanel Margin="0,5"><TextBlock Text="▰  左侧端点"/><TextBlock Text="▰  右侧端点"/><TextBlock Text="▱  文件"/></StackPanel><Separator Margin="0,12,0,8"/><TextBlock Text="同步选项" FontWeight="Bold"/><TextBlock Text="同步并发数" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal"><Slider x:Name="Concurrency" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Concurrency_ValueChanged" Width="190"/><TextBlock x:Name="ConcurrencyValue" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel><TextBlock Text="默认 3 路并行传输" Foreground="#52606D"/><CheckBox x:Name="VerifyCopies" Content="复制后验证文件大小" IsChecked="True" Margin="0,8,0,0"/><CheckBox x:Name="ShowCompleted" Content="同步完成后保留进度" IsChecked="True" Margin="0,4,0,0"/><Button Click="SaveSettings_Click" Margin="0,13,0,0">保存设置</Button></StackPanel>
   </Grid>
   <Grid Grid.Column="1" Margin="8,0,8,7"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="30"/><RowDefinition Height="94"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,6,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Drag &amp; drop"/><DockPanel><Button DockPanel.Dock="Right" Click="BrowseLeft_Click">Browse</Button><TextBox x:Name="LeftPath" Height="29" VerticalContentAlignment="Center"/></DockPanel></StackPanel><Button x:Name="SwapButton" Grid.Column="1" Click="Swap_Click" ToolTip="交换左右端点" FontSize="24" Foreground="#159447" Padding="0" Background="Transparent" BorderThickness="0">⇄</Button><StackPanel Grid.Column="2"><TextBlock Text="Drag &amp; drop"/><DockPanel><Button DockPanel.Dock="Right" Click="BrowseRight_Click">Browse</Button><TextBox x:Name="RightPath" Height="29" VerticalContentAlignment="Center"/></DockPanel></StackPanel></Grid>
    <DataGrid Grid.Row="1" x:Name="Comparison" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" CellEditEnding="Comparison_CellEditEnding" GridLinesVisibility="Horizontal" RowHeaderWidth="30" AlternatingRowBackground="#F7F7F7"><DataGrid.Columns><DataGridCheckBoxColumn Header="" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30"/><DataGridTextColumn Header="Relative path" Binding="{Binding LeftDisplay}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Size" Binding="{Binding LeftSize}" Width="90" IsReadOnly="True"/><DataGridTemplateColumn Header="Action" Width="110" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ActionDisplay}" Foreground="{Binding ActionBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Relative path" Binding="{Binding RightDisplay}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Size" Binding="{Binding RightSize}" Width="90" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource PanelLine}" BorderThickness="1,0,1,1" Padding="6,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary"/><TextBlock Grid.Column="1" Text="Showing all compared items" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="双向同步预览" HorizontalAlignment="Right"/></Grid></Border>
    <Border Grid.Row="3" Margin="0,7,0,0" Background="White" BorderBrush="{StaticResource PanelLine}" BorderThickness="1" Padding="8"><StackPanel><DockPanel><TextBlock Text="同步进度" FontWeight="Bold"/><TextBlock x:Name="ProgressText" DockPanel.Dock="Right"/></DockPanel><ProgressBar x:Name="ProgressBar" Height="13" Minimum="0" Maximum="100" Margin="0,6,0,0"/><TextBlock x:Name="CurrentFile" Foreground="#53606B" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
