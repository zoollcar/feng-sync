<Window x:Class="FengSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FengSync.Views"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Feng Sync" Height="768" Width="1320"
        MinHeight="680" MinWidth="1120"
        Background="{DynamicResource AppCanvasBrush}"
        FontFamily="{StaticResource DefaultFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition x:Name="SidebarColumn" Width="248" MinWidth="220" MaxWidth="320"/>
   <ColumnDefinition Width="1"/>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition x:Name="SummaryColumn" Width="272" MinWidth="240"/>
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
   <RowDefinition Height="64"/>
   <RowDefinition Height="120"/>
   <RowDefinition Height="52"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="32"/>
  </Grid.RowDefinitions>

  <!-- =================== 左栏：Profile 工作区（横跨前4行） =================== -->
  <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="4"
          Background="{DynamicResource SurfaceSubtleBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}"
          BorderThickness="0,0,1,0">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Brand (64 dp) -->
    <DockPanel Grid.Row="0" Margin="20,16" LastChildFill="True">
      <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
       <fluent:FluentIcon Icon="ArrowSync" Width="20" Height="20" FontSize="20" Foreground="{DynamicResource TextOnAccentBrush}" Style="{StaticResource LibraryIconStyle}"/>
     </Border>
     <TextBlock Text="Feng Sync" Style="{StaticResource DisplayTitleTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- 新建同步主操作 -->
    <Button x:Name="NewProfileButton" Grid.Row="1"
            AutomationProperties.AutomationId="NewProfileButton"
            AutomationProperties.Name="新建同步"
            Click="NewProfile_Click"
            Style="{StaticResource PrimaryButtonStyle}"
            Margin="20,0,20,16">
     <DockPanel>
       <fluent:FluentIcon DockPanel.Dock="Left" Icon="Add" Width="18" Height="18" FontSize="18" Margin="0,0,8,0" Style="{StaticResource LibraryIconStyle}"/>
      <TextBlock Text="新建同步" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
     </DockPanel>
    </Button>

    <TextBlock Grid.Row="2" Text="同步配置" Style="{StaticResource CaptionTextStyle}" Margin="20,4,20,8"/>

    <!-- Profile 列表 -->
    <ListBox x:Name="ProfileList" AutomationProperties.AutomationId="ProfileList"
             Grid.Row="3" BorderThickness="0"
             Background="Transparent"
             SelectionMode="Single"
             ItemContainerStyle="{StaticResource ProfileListItemStyle}"
             SelectionChanged="ProfileList_SelectionChanged"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <DockPanel LastChildFill="True">
        <fluent:FluentIcon DockPanel.Dock="Right" Icon="MoreHorizontal" Width="16" Height="16" FontSize="16" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource LibraryIconStyle}"/>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="Folder" Width="20" Height="20" FontSize="20" Margin="0,0,10,0" Style="{StaticResource LibraryIconStyle}"/>
        <StackPanel Margin="0,2,0,2">
         <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding LastRunLabel}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </DockPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
     <ListBox.ContextMenu>
      <ContextMenu x:Name="ProfileContextMenu" AutomationProperties.AutomationId="ProfileContextMenu">
       <MenuItem Header="编辑配置…" Click="EditProfile_Click" AutomationProperties.AutomationId="ProfileContextEdit"/>
       <MenuItem Header="复制" Click="DuplicateProfile_Click" AutomationProperties.AutomationId="ProfileContextDuplicate"/>
       <MenuItem Header="导入…" Click="OpenProfileFile_Click" AutomationProperties.AutomationId="ProfileContextImport"/>
       <MenuItem Header="导出…" Click="ExportProfile_Click" AutomationProperties.AutomationId="ProfileContextExport"/>
       <MenuItem Header="保存为批处理作业…" Click="SaveBatchJob_Click" AutomationProperties.AutomationId="ProfileContextBatch"/>
       <Separator/>
       <MenuItem Header="删除" Click="DeleteProfile_Click" AutomationProperties.AutomationId="ProfileContextDelete" Foreground="{DynamicResource DangerBrush}"/>
      </ContextMenu>
     </ListBox.ContextMenu>
    </ListBox>

    <!-- 底部：工具与设置入口 -->
    <StackPanel Grid.Row="4" Margin="20,12,20,16">
     <Button x:Name="RemoteEndpointsButton" AutomationProperties.AutomationId="RemoteEndpointsButton"
             Click="ManageRemoteEndpoints_Click" Style="{StaticResource TertiaryButtonStyle}"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
      <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="Cloud" Width="20" Height="20" FontSize="20" Margin="0,0,10,0" Style="{StaticResource LibraryIconStyle}"/>
       <TextBlock Text="云盘管理" VerticalAlignment="Center"/>
      </DockPanel>
     </Button>
     <Button x:Name="SchedulesButton" AutomationProperties.AutomationId="SchedulesButton"
             Click="ManageSchedule_Click" Style="{StaticResource TertiaryButtonStyle}"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,0">
      <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="Calendar" Width="20" Height="20" FontSize="20" Margin="0,0,10,0" Style="{StaticResource LibraryIconStyle}"/>
       <TextBlock Text="计划任务" VerticalAlignment="Center"/>
      </DockPanel>
     </Button>
     <Button x:Name="BatchJobsButton" AutomationProperties.AutomationId="BatchJobsButton"
             Click="OpenBatchRun_Click" Style="{StaticResource TertiaryButtonStyle}"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,0">
      <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="Play" Width="20" Height="20" FontSize="20" Margin="0,0,10,0" Style="{StaticResource LibraryIconStyle}"/>
       <TextBlock Text="批处理" VerticalAlignment="Center"/>
      </DockPanel>
     </Button>
     <Separator Margin="0,12,0,8"/>
     <Button x:Name="SettingsButton" AutomationProperties.AutomationId="SettingsButton"
             Click="SettingsButton_Click" Style="{StaticResource TertiaryButtonStyle}"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
      <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="Settings" Width="20" Height="20" FontSize="20" Margin="0,0,10,0" Style="{StaticResource LibraryIconStyle}"/>
       <TextBlock Text="设置" VerticalAlignment="Center"/>
      </DockPanel>
     </Button>
     <Button x:Name="HelpButton" AutomationProperties.AutomationId="HelpButton"
             Click="About_Click" Style="{StaticResource TertiaryButtonStyle}"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,0">
      <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="Info" Width="20" Height="20" FontSize="20" Margin="0,0,10,0" Style="{StaticResource LibraryIconStyle}"/>
       <TextBlock Text="关于" VerticalAlignment="Center"/>
      </DockPanel>
     </Button>
    </StackPanel>
   </Grid>
  </Border>

  <!-- 分隔线 -->
  <Rectangle Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Fill="{DynamicResource BorderSubtleBrush}"/>
  <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" ShowsPreview="False" DragCompleted="SidebarSplitter_DragCompleted"/>

  <!-- =================== 中栏：4 个 panel =================== -->
  <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource AppCanvasBrush}">
   <Grid.RowDefinitions>
    <RowDefinition Height="64"/>
     <RowDefinition Height="120"/>
    <RowDefinition Height="52"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

   <!-- 顶部 Header：主工作区的标题 Surface -->
   <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
    <DockPanel Margin="24,0,16,0" LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="EditCurrentProfileButton" AutomationProperties.AutomationId="EditCurrentProfileButton"
              Click="EditProfile_Click" Style="{StaticResource TertiaryButtonStyle}" ToolTip="编辑配置">
       <DockPanel>
         <fluent:FluentIcon DockPanel.Dock="Left" Icon="Edit" Width="18" Height="18" FontSize="18" Margin="0,0,6,0" Style="{StaticResource LibraryIconStyle}"/>
        <TextBlock Text="编辑配置" VerticalAlignment="Center"/>
       </DockPanel>
      </Button>
     </StackPanel>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="CurrentProfileTitle" AutomationProperties.AutomationId="CurrentProfileTitle"
                 Text="未选择同步配置" Style="{StaticResource DisplayTitleTextStyle}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="LastRunStatus" AutomationProperties.AutomationId="LastRunStatus" Style="{StaticResource CaptionTextStyle}" Text="选择左右端点后即可比较"/>
     </StackPanel>
    </DockPanel>
   </Border>

   <!-- 端点与操作栏：以 Canvas 承托两个可辨识的 Endpoint 卡片 -->
   <Border Grid.Row="1" Background="{DynamicResource AppCanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
    <Grid Margin="24,12,16,12">
     <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="40"/>
     </Grid.RowDefinitions>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>

     <!-- 左端点卡片 -->
     <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource EndpointSelectorStyle}" Height="56" Padding="8" Margin="0,0,12,0">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource SurfaceSubtleBrush}" VerticalAlignment="Center">
         <fluent:FluentIcon x:Name="LeftEndpointIcon" Icon="Folder" Width="20" Height="20" FontSize="20" Style="{StaticResource LibraryIconStyle}"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="LeftEndpointTitle" Text="未选择端点" Style="{StaticResource CaptionTextStyle}"/>
        <TextBlock x:Name="LeftEndpointPath" AutomationProperties.AutomationId="LeftEndpointPath" Text="选择一个端点" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <Button AutomationProperties.AutomationId="AddLeftLocalEndpoint" AutomationProperties.Name="选择左侧本地端点" Content="本地" Click="BrowseLeft_Click" Style="{StaticResource TertiaryButtonStyle}"/>
        <Button AutomationProperties.AutomationId="AddLeftCloudEndpoint" AutomationProperties.Name="选择左侧云端端点" Content="云端" Tag="Left" Click="AddCloudEndpoint_Click" Style="{StaticResource TertiaryButtonStyle}"/>
       </StackPanel>
       <TextBox x:Name="LeftPath" AutomationProperties.AutomationId="LeftPath" Visibility="Collapsed" Width="0" Height="0"/>
      </Grid>
     </Border>

     <!-- 交换按钮 -->
     <Button x:Name="SwapEndpointsButton" Grid.Row="0" Grid.Column="1"
             AutomationProperties.AutomationId="SwapEndpointsButton"
             AutomationProperties.Name="交换左右端点"
             Click="Swap_Click" Style="{StaticResource EndpointSwapButtonStyle}"
             Margin="0,0,12,0" ToolTip="交换左右端点">
       <fluent:FluentIcon Icon="ArrowSwap" Width="18" Height="18" FontSize="18" Style="{StaticResource LibraryIconStyle}"/>
     </Button>

     <!-- 右端点卡片 -->
     <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource EndpointSelectorStyle}" Height="56" Padding="8">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource SurfaceSubtleBrush}" VerticalAlignment="Center">
         <fluent:FluentIcon x:Name="RightEndpointIcon" Icon="Cloud" Width="20" Height="20" FontSize="20" Style="{StaticResource LibraryIconStyle}"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="RightEndpointTitle" Text="未选择端点" Style="{StaticResource CaptionTextStyle}"/>
        <TextBlock x:Name="RightEndpointPath" AutomationProperties.AutomationId="RightEndpointPath" Text="选择一个端点" Style="{StaticResource BodyStrongTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <Button AutomationProperties.AutomationId="AddRightLocalEndpoint" AutomationProperties.Name="选择右侧本地端点" Content="本地" Click="BrowseRight_Click" Style="{StaticResource TertiaryButtonStyle}"/>
        <Button AutomationProperties.AutomationId="AddRightCloudEndpoint" AutomationProperties.Name="选择右侧云端端点" Content="云端" Tag="Right" Click="AddCloudEndpoint_Click" Style="{StaticResource TertiaryButtonStyle}"/>
       </StackPanel>
       <TextBox x:Name="RightPath" AutomationProperties.AutomationId="RightPath" Visibility="Collapsed" Width="0" Height="0"/>
      </Grid>
     </Border>

     <!-- 同步模式与执行操作位于端点路径下方 -->
     <ComboBox x:Name="SyncModeBox" Grid.Row="1" Grid.Column="0"
               AutomationProperties.AutomationId="SyncModeBox"
               Width="136" Margin="0,8,0,0" SelectedIndex="0"
               HorizontalAlignment="Left" VerticalContentAlignment="Center"
               SelectionChanged="SyncMode_Changed">
      <ComboBoxItem Content="双向同步"/>
      <ComboBoxItem Content="镜像到右侧"/>
      <ComboBoxItem Content="更新到右侧"/>
     </ComboBox>

     <!-- 比较按钮 (次要) -->
     <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
     <Button x:Name="CompareButton"
             AutomationProperties.AutomationId="CompareButton"
             AutomationProperties.Name="比较" Click="Compare_Click"
             Style="{StaticResource SecondaryButtonStyle}"
              MinWidth="100" Margin="0,0,8,0">
       <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="ArrowsBidirectional" Width="18" Height="18" FontSize="18" Margin="0,0,8,0" Style="{StaticResource LibraryIconStyle}"/>
        <TextBlock Text="比较" VerticalAlignment="Center"/>
       </DockPanel>
     </Button>

     <!-- 开始同步按钮 (主操作) -->
     <Button x:Name="SyncButton"
             AutomationProperties.AutomationId="SyncButton"
             AutomationProperties.Name="开始同步" Click="Sync_Click"
             Style="{StaticResource PrimaryButtonStyle}"
              MinWidth="120" IsEnabled="False">
       <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="ArrowSync" Width="18" Height="18" FontSize="18" Margin="0,0,8,0" Style="{StaticResource LibraryIconStyle}"/>
        <TextBlock x:Name="SyncButtonLabel" Text="开始同步" VerticalAlignment="Center"/>
       </DockPanel>
     </Button>
     </StackPanel>
    </Grid>
   </Border>

   <!-- 变更预览工具栏 -->
   <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
    <Grid Margin="24,0,16,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <ComboBox x:Name="ChangeFilterBox" AutomationProperties.AutomationId="ChangeFilterBox" Width="124" Height="32" SelectedIndex="0" SelectionChanged="ChangeFilterBox_SelectionChanged" Margin="0,0,8,0">
       <ComboBoxItem Content="全部"/>
       <ComboBoxItem Content="上传"/>
       <ComboBoxItem Content="下载"/>
       <ComboBoxItem Content="删除"/>
       <ComboBoxItem Content="冲突"/>
       <ComboBoxItem Content="已忽略"/>
      </ComboBox>
      <Button x:Name="ExportPlanButton" AutomationProperties.AutomationId="ExportPlanButton" AutomationProperties.Name="导出同步计划" Click="ExportPlan_Click" Style="{StaticResource TertiaryButtonStyle}">
       <DockPanel>
        <fluent:FluentIcon DockPanel.Dock="Left" Icon="ArrowExport" Width="16" Height="16" FontSize="16" Margin="0,0,6,0" Style="{StaticResource LibraryIconStyle}"/>
        <TextBlock Text="导出" VerticalAlignment="Center"/>
       </DockPanel>
      </Button>
     </StackPanel>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Text="变更预览" Style="{StaticResource SectionTitleTextStyle}"/>
      <TextBlock x:Name="CompareResultStatus" AutomationProperties.AutomationId="CompareResultStatus" Style="{StaticResource CaptionTextStyle}" Text="尚未比较" Margin="12,0,0,0"/>
     </StackPanel>
     <Grid Grid.Column="1" Width="248" Margin="16,0" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <fluent:FluentIcon Icon="Search" Width="16" Height="16" FontSize="16" Margin="10,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource LibraryIconStyle}"/>
      <TextBox x:Name="ChangeSearchBox" Grid.Column="1" AutomationProperties.AutomationId="ChangeSearchBox" AutomationProperties.Name="搜索变更文件" VerticalContentAlignment="Center" TextChanged="ChangeSearchBox_TextChanged" ToolTip="搜索文件名"/>
     </Grid>
    </Grid>
   </Border>

   <!-- DataGrid：Canvas 中唯一主要内容 Surface；空状态不覆盖列标题。 -->
   <Grid Grid.Row="3" Margin="24,16,16,16">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}">
     <DataGrid x:Name="Comparison" AutomationProperties.AutomationId="Comparison"
               AutoGenerateColumns="False" CanUserAddRows="False"
               IsReadOnly="False" SelectionMode="Extended"
               HeadersVisibility="Column" GridLinesVisibility="Horizontal"
               RowHeight="40" ColumnHeaderHeight="40"
               AlternatingRowBackground="{DynamicResource SurfaceSubtleBrush}"
               HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
               Background="Transparent" BorderThickness="0"
               CurrentCellChanged="Comparison_CurrentCellChanged">
      <DataGrid.Columns>
       <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
       <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" IsReadOnly="True">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="同步方向" Binding="{Binding DirectionDisplay}" Width="88" IsReadOnly="True">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="HorizontalAlignment" Value="Center"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
          <Setter Property="FontSize" Value="12"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTemplateColumn Header="操作" Width="88" IsReadOnly="True">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <Border Background="Transparent" Padding="2">
           <Border.ContextMenu>
            <ContextMenu>
             <MenuItem Header="左侧覆盖右侧" Click="ActionMenu_KeepLeft_Click"/>
             <MenuItem Header="右侧覆盖左侧" Click="ActionMenu_KeepRight_Click"/>
             <Separator/>
             <MenuItem Header="忽略此文件" Click="ActionMenu_Ignore_Click"/>
             <MenuItem Header="重新启用此文件" Click="ActionMenu_Enable_Click"/>
            </ContextMenu>
           </Border.ContextMenu>
           <Border Style="{StaticResource StatusChipStyle}" Background="{Binding OperationSeverity, Converter={x:Static views:AppConverters.SeverityBackgroundConverter}}">
            <TextBlock Text="{Binding OperationLabel}" Style="{StaticResource StatusChipTextStyle}"/>
           </Border>
          </Border>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="大小" Binding="{Binding OperationSize, Converter={x:Static views:AppConverters.NullableBytesConverter}}" Width="92" IsReadOnly="True">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="HorizontalAlignment" Value="Right"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
          <Setter Property="FontSize" Value="12"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedUtc, Converter={x:Static views:AppConverters.ModifiedConverter}}" Width="160" IsReadOnly="True">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="HorizontalAlignment" Value="Right"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
          <Setter Property="FontSize" Value="12"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Border>

    <StackPanel x:Name="ComparisonEmptyState" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Width="48" Height="48" CornerRadius="{StaticResource RadiusMedium}" Background="{DynamicResource SurfaceSubtleBrush}" HorizontalAlignment="Center">
       <fluent:FluentIcon Icon="ScaleFill" Width="24" Height="24" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource LibraryIconStyle}"/>
      </Border>
      <TextBlock x:Name="ComparisonEmptyStateText" AutomationProperties.AutomationId="ComparisonEmptyStateText" Text="请选择两个端点后点击比较" Style="{StaticResource BodyTextStyle}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
     </StackPanel>
    </StackPanel>
   </Grid>
  </Grid>

  <!-- =================== 右侧：变更摘要（跨前4行） =================== -->
  <Border Grid.Column="3" Grid.Row="0" Grid.RowSpan="4"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
    <StackPanel>
     <TextBlock Text="本次变更" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,16"/>

     <StackPanel x:Name="ChangeSummaryPanel" AutomationProperties.AutomationId="ChangeSummaryPanel">

      <Grid Margin="0,0,0,14">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource SuccessSubtleBackgroundBrush}" VerticalAlignment="Center">
        <fluent:FluentIcon Icon="ArrowUpload" Width="18" Height="18" FontSize="18" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource LibraryIconStyle}"/>
       </Border>
       <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="UploadSummary" AutomationProperties.AutomationId="UploadSummary" Style="{StaticResource BodyStrongTextStyle}" Text="上传 0 项"/>
        <TextBlock x:Name="UploadSizeSummary" Style="{StaticResource CaptionTextStyle}" Text="0 B"/>
       </StackPanel>
      </Grid>

      <Grid Margin="0,0,0,14">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource InfoSubtleBackgroundBrush}" VerticalAlignment="Center">
        <fluent:FluentIcon Icon="ArrowDownload" Width="18" Height="18" FontSize="18" Foreground="{DynamicResource InfoBrush}" Style="{StaticResource LibraryIconStyle}"/>
       </Border>
       <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="DownloadSummary" AutomationProperties.AutomationId="DownloadSummary" Style="{StaticResource BodyStrongTextStyle}" Text="下载 0 项"/>
        <TextBlock x:Name="DownloadSizeSummary" Style="{StaticResource CaptionTextStyle}" Text="0 B"/>
       </StackPanel>
      </Grid>

      <Grid Margin="0,0,0,14">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource DangerSubtleBackgroundBrush}" VerticalAlignment="Center">
        <fluent:FluentIcon Icon="Delete" Width="18" Height="18" FontSize="18" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource LibraryIconStyle}"/>
       </Border>
       <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="DeleteSummary" AutomationProperties.AutomationId="DeleteSummary" Style="{StaticResource BodyStrongTextStyle}" Text="删除 0 项"/>
        <TextBlock x:Name="DeleteSizeSummary" Style="{StaticResource CaptionTextStyle}" Text="—"/>
       </StackPanel>
      </Grid>

      <Grid Margin="0,0,0,14">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusSmall}" Background="{DynamicResource WarningSubtleBackgroundBrush}" VerticalAlignment="Center">
        <fluent:FluentIcon Icon="Warning" Width="20" Height="20" FontSize="20" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource LibraryIconStyle}"/>
       </Border>
       <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="ConflictSummary" AutomationProperties.AutomationId="ConflictSummary" Style="{StaticResource BodyStrongTextStyle}" Text="冲突 0 项"/>
        <TextBlock x:Name="ConflictSizeSummary" Style="{StaticResource CaptionTextStyle}" Text="0 B"/>
       </StackPanel>
      </Grid>

      <Border x:Name="ChangeSummaryTotal" Style="{StaticResource ChangeSummaryTotalStyle}">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="总计（待传输）" Style="{StaticResource CaptionTextStyle}"/>
         <TextBlock x:Name="TotalSummary" AutomationProperties.AutomationId="TotalSummary" Style="{StaticResource MetricTextStyle}" Text="0 项"/>
        </StackPanel>
        <TextBlock x:Name="TotalSizeSummary" Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource BodyStrongTextStyle}" Text="0 B"/>
       </Grid>
      </Border>
     </StackPanel>

    </StackPanel>
   </ScrollViewer>
  </Border>

  <!-- =================== 状态栏 (横跨所有列) =================== -->
  <Border Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="4"
          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
   <Grid Margin="20,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="220"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock x:Name="ProfileContextStatus" Grid.Column="0" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Text="Profile 工作区"/>
    <TextBlock x:Name="Status" AutomationProperties.AutomationId="Status" Grid.Column="1" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="已选择 " Style="{StaticResource StatusTextStyle}"/>
     <TextBlock x:Name="SelectedLabel" Style="{StaticResource StatusTextStyle}" FontWeight="SemiBold" Text="0"/>
     <TextBlock Text=" 项  ·  并发 " Style="{StaticResource StatusTextStyle}"/>
     <TextBlock x:Name="ConcurrencyLabel" AutomationProperties.AutomationId="ConcurrencyLabel" Style="{StaticResource StatusTextStyle}" FontWeight="SemiBold"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
