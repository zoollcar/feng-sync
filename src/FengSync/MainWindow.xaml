<Window x:Class="FengSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Feng Sync" Height="730" Width="1320" MinHeight="640" MinWidth="1040" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI">
 <DockPanel>
  <Menu DockPanel.Dock="Top"><MenuItem Header="文件" AutomationProperties.AutomationId="FileMenu"><MenuItem Header="新建" AutomationProperties.AutomationId="NewProfileMenuItem" Click="NewProfile_Click"/><MenuItem Header="编辑 Profile…" AutomationProperties.AutomationId="EditProfileMenuItem" Click="EditProfile_Click"/><MenuItem Header="打开…" Click="OpenProfileFile_Click"/><MenuItem Header="保存" AutomationProperties.AutomationId="SaveProfileMenuItem" Click="SaveProfile_Click"/><MenuItem Header="另存为…" Click="ExportProfile_Click"/><MenuItem Header="另存为批处理作业…" Click="SaveBatchJob_Click"/></MenuItem><MenuItem Header="操作" AutomationProperties.AutomationId="OperationsMenu"><MenuItem Header="显示日志" AutomationProperties.AutomationId="ShowLogMenuItem" Click="ShowLog_Click"/><MenuItem Header="运行历史…" AutomationProperties.AutomationId="RunHistoryMenuItem" Click="ShowRunHistory_Click"/></MenuItem><MenuItem Header="工具" AutomationProperties.AutomationId="ToolsMenu"><MenuItem Header="选项…" AutomationProperties.AutomationId="OptionsMenuItem" Click="Options_Click"/><MenuItem Header="远程端点管理…" AutomationProperties.AutomationId="RemoteEndpointManager" Click="ManageRemoteEndpoints_Click"/><Separator/><MenuItem Header="计划任务…" AutomationProperties.AutomationId="ScheduleMenuItem" Click="ManageSchedule_Click"/></MenuItem><MenuItem Header="帮助" AutomationProperties.AutomationId="HelpMenu"><MenuItem Header="检查更新…" AutomationProperties.AutomationId="CheckUpdatesMenuItem" Click="CheckUpdates_Click"/><Separator/><MenuItem Header="关于" AutomationProperties.AutomationId="AboutMenuItem" Click="About_Click"/></MenuItem></Menu>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="220" MaxWidth="380"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border AutomationProperties.AutomationId="ProfileWorkspace" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" BorderBrush="{DynamicResource SecondaryForegroundBrush}" BorderThickness="0,0,1,0" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="ProfileWorkspaceHeader" AutomationProperties.AutomationId="ProfileWorkspaceHeader" Text="Profile 管理" Style="{StaticResource SectionTitleTextStyle}" Margin="4,4,4,8"/>
    <WrapPanel Grid.Row="1" Margin="0,0,0,6"><Button x:Name="NewProfileButton" AutomationProperties.AutomationId="NewProfileButton" AutomationProperties.Name="新建 Profile" Click="NewProfile_Click" ToolTip="新建 Profile" Style="{StaticResource IconButtonStyle}"><TextBlock Text="&#xE710;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button x:Name="EditProfileButton" AutomationProperties.AutomationId="EditProfileButton" AutomationProperties.Name="编辑 Profile" Click="EditProfile_Click" ToolTip="编辑 Profile" Style="{StaticResource IconButtonStyle}"><TextBlock Text="&#xE70F;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button x:Name="OpenProfileButton" AutomationProperties.AutomationId="OpenProfileButton" AutomationProperties.Name="打开配置文件" Click="OpenProfileFile_Click" ToolTip="打开配置文件" Style="{StaticResource IconButtonStyle}"><TextBlock Text="&#xE8E5;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button x:Name="SaveProfileButton" AutomationProperties.AutomationId="SaveProfileButton" AutomationProperties.Name="保存配置" Click="SaveProfile_Click" ToolTip="保存配置" Style="{StaticResource IconButtonStyle}"><TextBlock Text="&#xE74E;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button x:Name="RunProfileButton" AutomationProperties.AutomationId="RunProfileButton" AutomationProperties.Name="运行所选配置" Click="RunProfile_Click" ToolTip="运行所选配置" Style="{StaticResource IconButtonStyle}"><TextBlock Text="&#xE768;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button x:Name="DeleteProfileButton" AutomationProperties.AutomationId="DeleteProfileButton" AutomationProperties.Name="从列表移除 Profile" Click="DeleteProfile_Click" ToolTip="从列表移除 Profile" Style="{StaticResource DangerIconButtonStyle}"><TextBlock Text="&#xE74D;" Style="{StaticResource SystemIconGlyphStyle}"/></Button></WrapPanel>
    <ListBox x:Name="ProfileList" AutomationProperties.AutomationId="ProfileList" Grid.Row="2" BorderThickness="0" DisplayMemberPath="Name" SelectionMode="Extended" SelectionChanged="ProfileList_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="ToolTip" Value="{Binding Name}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
    <TextBlock x:Name="ProfileSelectionLabel" Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" Margin="4,6,4,0"/>
   </Grid></Border>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DragCompleted="SidebarSplitter_DragCompleted" Background="Transparent"/>
   <ScrollViewer Grid.Column="2" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="CompareButton" AutomationProperties.AutomationId="CompareButton" AutomationProperties.Name="比较" Click="Compare_Click" ToolTip="比较文件时间和大小" Style="{StaticResource PrimaryActionButtonStyle}" MinWidth="126"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource SystemIconGlyphStyle}" Margin="0,0,6,0"/><TextBlock Text="比较" FontSize="16" FontWeight="SemiBold"/></StackPanel></Button><ComboBox x:Name="SyncModeBox" Grid.Column="1" AutomationProperties.AutomationId="SyncModeBox" AutomationProperties.Name="同步模式" Width="110" Height="32" Margin="4" SelectedIndex="0" SelectionChanged="SyncMode_Changed"><ComboBoxItem Content="双向 ↔"/><ComboBoxItem Content="镜像 →"/><ComboBoxItem Content="更新 →"/></ComboBox><Button Grid.Column="2" AutomationProperties.AutomationId="EditCurrentProfileButton" AutomationProperties.Name="Profile 设置" Click="EditProfile_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Profile 设置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource SystemIconGlyphStyle}" Margin="0,0,4,0"/><TextBlock Text="设置"/></StackPanel></Button><Button Grid.Column="3" AutomationProperties.AutomationId="KeepRightButton" AutomationProperties.Name="右侧覆盖左侧" Click="KeepRight_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="右侧覆盖左侧（含冲突保留右侧、删除项也删对侧）"><TextBlock Text="&#xE72B;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button Grid.Column="4" AutomationProperties.AutomationId="KeepLeftButton" AutomationProperties.Name="左侧覆盖右侧" Click="KeepLeft_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="左侧覆盖右侧（含冲突保留左侧、删除项恢复对侧）"><TextBlock Text="&#xE72A;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button x:Name="SyncButton" Grid.Column="5" AutomationProperties.AutomationId="SyncButton" AutomationProperties.Name="同步" Click="Sync_Click" IsEnabled="False" Style="{StaticResource PrimaryActionButtonStyle}" MinWidth="132"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource SystemIconGlyphStyle}" Margin="0,0,6,0"/><StackPanel><TextBlock Text="同步" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SyncModeCaption" Text="双向 ↔" Style="{StaticResource SecondaryTextStyle}"/></StackPanel></StackPanel></Button>
   </Grid></ScrollViewer>
   <Grid Grid.Column="2" Grid.Row="1" Margin="8,0,8,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="左侧端点（本地文件夹、SFTP、Google Drive 或 S3）" Style="{StaticResource SecondaryTextStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LeftPath" AutomationProperties.AutomationId="LeftPath" Style="{StaticResource EndpointTextBoxStyle}"/><Button Grid.Column="1" AutomationProperties.AutomationId="AddLeftCloudEndpoint" AutomationProperties.Name="选择左侧云端端点" Click="AddCloudEndpoint_Click" Tag="Left" ToolTip="选择左侧云端端点" Style="{StaticResource EndpointButtonStyle}"><TextBlock Text="&#xE753;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button Grid.Column="2" Click="BrowseLeft_Click" Style="{StaticResource EndpointButtonStyle}" ToolTip="浏览左侧文件夹">浏览…</Button></Grid></StackPanel><Button Grid.Column="1" AutomationProperties.AutomationId="SwapEndpointsButton" AutomationProperties.Name="交换左右端点" Click="Swap_Click" ToolTip="交换左右端点" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Bottom"><TextBlock Text="&#xE8AB;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><StackPanel Grid.Column="2"><TextBlock Text="右侧端点（本地文件夹、SFTP、Google Drive 或 S3）" Style="{StaticResource SecondaryTextStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RightPath" AutomationProperties.AutomationId="RightPath" Style="{StaticResource EndpointTextBoxStyle}"/><Button Grid.Column="1" AutomationProperties.AutomationId="AddRightCloudEndpoint" AutomationProperties.Name="选择右侧云端端点" Click="AddCloudEndpoint_Click" Tag="Right" ToolTip="选择右侧云端端点" Style="{StaticResource EndpointButtonStyle}"><TextBlock Text="&#xE753;" Style="{StaticResource SystemIconGlyphStyle}"/></Button><Button Grid.Column="2" Click="BrowseRight_Click" Style="{StaticResource EndpointButtonStyle}" ToolTip="浏览右侧文件夹">浏览…</Button></Grid></StackPanel></Grid>
    <Grid Grid.Row="1"><DataGrid x:Name="Comparison" AutomationProperties.AutomationId="Comparison" Style="{StaticResource ComparisonDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Extended" CurrentCellChanged="Comparison_CurrentCellChanged"><DataGrid.Columns><DataGridCheckBoxColumn Header="选择" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52"/><DataGridTextColumn Header="左侧相对路径" Binding="{Binding LeftDisplay}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="大小" Binding="{Binding LeftSize}" Width="90" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTemplateColumn Header="操作" Width="110" IsReadOnly="True"><DataGridTemplateColumn.CellStyle><Style TargetType="DataGridCell"><Setter Property="HorizontalContentAlignment" Value="Center"/></Style></DataGridTemplateColumn.CellStyle><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="Transparent"><Border.ContextMenu><ContextMenu><MenuItem Header="左侧覆盖右侧（含恢复对侧）" Click="ActionMenu_KeepLeft_Click"/><MenuItem Header="右侧覆盖左侧（含删除对侧）" Click="ActionMenu_KeepRight_Click"/><Separator/><MenuItem Header="忽略此文件" Click="ActionMenu_Ignore_Click"/><MenuItem Header="重新启用此文件" Click="ActionMenu_Enable_Click"/></ContextMenu></Border.ContextMenu><TextBlock Text="{Binding ActionDisplay}" Foreground="{Binding ActionBrush}" FontSize="18" FontWeight="Bold" ToolTip="{Binding ConflictToolTip}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="右侧相对路径" Binding="{Binding RightDisplay}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="大小" Binding="{Binding RightSize}" Width="90" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid><Border x:Name="ComparisonEmptyState" IsHitTestVisible="False" Background="{DynamicResource WindowBackgroundBrush}" Opacity="0.86"><TextBlock x:Name="ComparisonEmptyStateText" Text="选择左右端点后开始比较" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
    <Border x:Name="PreviewPanel" AutomationProperties.AutomationId="PreviewPanel" Grid.Row="2" Style="{StaticResource PreviewPanelStyle}" Margin="0,8,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" AutomationProperties.AutomationId="Summary" Style="{StaticResource BodyTextStyle}"/><TextBlock x:Name="TransferSizeLabel" Grid.Column="1" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="同步预览" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="SafetySummary" AutomationProperties.AutomationId="SafetySummary" Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Grid></Border>
   </Grid>
   <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Style="{StaticResource StatusBarStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Profile 工作区" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><TextBlock x:Name="Status" AutomationProperties.AutomationId="Status" Grid.Column="1" Style="{StaticResource StatusTextStyle}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="已选择 " Style="{StaticResource StatusTextStyle}"/><TextBlock x:Name="SelectedLabel" Style="{StaticResource StatusTextStyle}" FontWeight="SemiBold"/><TextBlock Text=" 项  ·  并发 " Style="{StaticResource StatusTextStyle}"/><TextBlock x:Name="ConcurrencyLabel" AutomationProperties.AutomationId="ConcurrencyLabel" Style="{StaticResource StatusTextStyle}" FontWeight="SemiBold"/></StackPanel></Grid></Border>
  </Grid>
 </DockPanel>
</Window>
