<Window x:Class="FengSync.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Feng Sync" Height="730" Width="1320" MinHeight="580" MinWidth="980" Background="#F5F5F5" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="PanelLine" Color="#AEB6BE"/><SolidColorBrush x:Key="BlueHeader" Color="#147AC2"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#F7F7F7"/><Setter Property="BorderBrush" Value="#BFC7CF"/></Style>
  <Style x:Key="Tool" TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#F4F4F4"/><Setter Property="BorderBrush" Value="#C0C6CC"/></Style>
  <Style x:Key="BlueTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource PanelLine}" BorderThickness="0,0,0,1">
   <MenuItem Header="文件"><MenuItem Header="新建" Click="NewProfile_Click"/><MenuItem Header="编辑 Profile…" Click="EditProfile_Click"/><MenuItem Header="打开…" Click="OpenProfileFile_Click"/><MenuItem Header="保存" Click="SaveProfile_Click"/><MenuItem Header="另存为…" Click="ExportProfile_Click"/><MenuItem Header="另存为批处理作业…" Click="SaveBatchJob_Click"/></MenuItem>
   <MenuItem Header="操作"><MenuItem Header="显示日志" Click="ShowLog_Click"/><MenuItem Header="运行历史…" Click="ShowRunHistory_Click"/></MenuItem>
   <MenuItem Header="工具"><MenuItem Header="选项…" Click="Options_Click"/><MenuItem Header="云端端点管理…" AutomationProperties.AutomationId="CloudEndpointManager" Click="ManageCloudEndpoints_Click"/><Separator/><MenuItem Header="计划任务…" AutomationProperties.AutomationId="ScheduleMenuItem" Click="ManageSchedule_Click"/></MenuItem>
   <MenuItem Header="帮助"><MenuItem Header="关于" Click="About_Click"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Height="78" Background="#F8F8F8" BorderBrush="{StaticResource PanelLine}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="CompareButton" Click="Compare_Click" Style="{StaticResource Tool}" MinWidth="190"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="30" Margin="0,0,10,0"/><StackPanel><TextBlock Text="比较" FontSize="19" FontWeight="Bold"/><TextBlock Text="文件时间和大小" Foreground="#53606B"/></StackPanel></StackPanel></Button><ComboBox x:Name="SyncModeBox" Width="104" Height="31" Margin="4" SelectedIndex="0" SelectionChanged="SyncMode_Changed"><ComboBoxItem Content="双向 ↔"/><ComboBoxItem Content="镜像 →"/><ComboBoxItem Content="更新 →"/><ComboBoxItem Content="自定义 →（尚不可用）" IsEnabled="False" ToolTip="自定义同步尚未实现。"/></ComboBox><Button Click="EditProfile_Click" Style="{StaticResource Tool}" ToolTip="Profile 设置"><TextBlock Text="⚙" FontSize="27" Foreground="#378CC6"/></Button><Button Click="KeepLeft_Click" Style="{StaticResource Tool}" ToolTip="设为左侧覆盖右侧"><TextBlock Text="→" FontSize="24"/></Button><Button Click="KeepRight_Click" Style="{StaticResource Tool}" ToolTip="设为右侧覆盖左侧"><TextBlock Text="←" FontSize="24"/></Button><Button x:Name="SyncButton" Click="Sync_Click" IsEnabled="False" Style="{StaticResource Tool}" Background="#DDF4D8" BorderBrush="#8EBA89" MinWidth="205"><StackPanel Orientation="Horizontal"><TextBlock Text="⟳" FontSize="30" Foreground="#159447" Margin="0,0,8,0"/><StackPanel><TextBlock Text="同步" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="SyncModeCaption" Text="双向 ↔" Foreground="#53606B"/></StackPanel></StackPanel></Button></StackPanel></Border>
  <Border DockPanel.Dock="Bottom" Background="#F8F8F8" BorderBrush="{StaticResource PanelLine}" BorderThickness="0,1,0,0" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Grid.Column="1" Foreground="#4A5863" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="统计："/><TextBlock x:Name="SelectedLabel" FontWeight="Bold"/><TextBlock Text=" 个已选  ·  并发 "/><TextBlock x:Name="ConcurrencyLabel" FontWeight="Bold"/></StackPanel></Grid></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Background="White"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="55"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource BlueHeader}" Padding="7,0"><TextBlock Text="Profile 管理" Style="{StaticResource BlueTitle}"/></Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="NewProfileButton" AutomationProperties.AutomationId="NewProfileButton" Click="NewProfile_Click" ToolTip="新建"><TextBlock Text="✚" Foreground="#12A24A" FontSize="22"/></Button><Button x:Name="EditProfileButton" AutomationProperties.AutomationId="EditProfileButton" Click="EditProfile_Click" ToolTip="编辑 Profile"><TextBlock Text="✎" FontSize="18"/></Button><Button x:Name="OpenProfileButton" AutomationProperties.AutomationId="OpenProfileButton" Click="OpenProfileFile_Click" ToolTip="打开配置文件"><TextBlock Text="📂" FontSize="18"/></Button><Button x:Name="SaveProfileButton" AutomationProperties.AutomationId="SaveProfileButton" Click="SaveProfile_Click" ToolTip="保存配置"><TextBlock Text="💾" FontSize="18"/></Button><Button x:Name="RunProfileButton" AutomationProperties.AutomationId="RunProfileButton" Click="RunProfile_Click" ToolTip="运行所选配置"><TextBlock Text="▶" FontSize="20" Foreground="#167A36"/></Button><Button x:Name="DeleteProfileButton" AutomationProperties.AutomationId="DeleteProfileButton" Click="DeleteProfile_Click" ToolTip="从本项目移除配置"><TextBlock Text="🗑" FontSize="18" Foreground="#A32626"/></Button></StackPanel>
    <ListBox x:Name="ProfileList" Grid.Row="2" BorderThickness="0" Margin="5" DisplayMemberPath="Name" SelectionMode="Extended" SelectionChanged="ProfileList_SelectionChanged"/>
   </Grid>
   <Grid Grid.Column="1" Margin="8,0,8,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,6,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="左侧端点（本地文件夹、SFTP、Google Drive 或 S3）"/><DockPanel><Button DockPanel.Dock="Right" Click="BrowseLeft_Click">Browse</Button><Button DockPanel.Dock="Right" Click="AddCloudEndpoint_Click" Tag="Left" ToolTip="连接 SFTP、Google Drive 或 S3" FontSize="16" Padding="7,3">☁</Button><TextBox x:Name="LeftPath" Height="29" VerticalContentAlignment="Center"/></DockPanel></StackPanel><Button Grid.Column="1" Click="Swap_Click" ToolTip="交换左右端点" FontSize="24" Foreground="#159447" Padding="0" Background="Transparent" BorderThickness="0">⇄</Button><StackPanel Grid.Column="2"><TextBlock Text="右侧端点（本地文件夹、SFTP、Google Drive 或 S3）"/><DockPanel><Button DockPanel.Dock="Right" Click="BrowseRight_Click">Browse</Button><Button DockPanel.Dock="Right" Click="AddCloudEndpoint_Click" Tag="Right" ToolTip="连接 SFTP、Google Drive 或 S3" FontSize="16" Padding="7,3">☁</Button><TextBox x:Name="RightPath" Height="29" VerticalContentAlignment="Center"/></DockPanel></StackPanel></Grid>
    <DataGrid Grid.Row="1" x:Name="Comparison" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" CurrentCellChanged="Comparison_CurrentCellChanged" GridLinesVisibility="Horizontal" RowHeaderWidth="30" AlternatingRowBackground="#F7F7F7"><DataGrid.Columns><DataGridCheckBoxColumn Header="" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="30"/><DataGridTextColumn Header="Relative path" Binding="{Binding LeftDisplay}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Size" Binding="{Binding LeftSize}" Width="90" IsReadOnly="True"/><DataGridTemplateColumn Header="Action" Width="110" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="Transparent"><Border.ContextMenu><ContextMenu><MenuItem Header="左侧覆盖右侧" Click="ActionMenu_KeepLeft_Click"/><MenuItem Header="右侧覆盖左侧" Click="ActionMenu_KeepRight_Click"/><Separator/><MenuItem Header="临时忽略" Click="ActionMenu_Ignore_Click"/></ContextMenu></Border.ContextMenu><TextBlock Text="{Binding ActionDisplay}" Foreground="{Binding ActionBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Relative path" Binding="{Binding RightDisplay}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Size" Binding="{Binding RightSize}" Width="90" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource PanelLine}" BorderThickness="1,0,1,1" Padding="6,3"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary"/><TextBlock x:Name="TransferSizeLabel" Grid.Column="1" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="同步预览" HorizontalAlignment="Right"/></Grid><TextBlock x:Name="SafetySummary" Foreground="#52606D" Margin="0,3,0,0"/></StackPanel></Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
