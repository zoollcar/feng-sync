<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><ApplicationIcon>Assets\Branding\FengSync.ico</ApplicationIcon><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><Version>0.2.0</Version><AssemblyVersion>0.2.0.0</AssemblyVersion><FileVersion>0.2.0.0</FileVersion></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FengSync.Core\FengSync.Core.csproj" />
    <!-- Build the unattended companion without linking its entry point into the WPF executable. -->
    <ProjectReference Include="..\FengSync.Cli\FengSync.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\rclone\rclone.exe" />
    <Content Include="Assets\rclone\rclone.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentIcons.Wpf" Version="2.1.333" />
  </ItemGroup>
  <Target Name="CopyAutomationCliToBuild" AfterTargets="Build">
    <ItemGroup>
      <AutomationCliFiles Include="$(MSBuildProjectDirectory)\..\FengSync.Cli\bin\$(Configuration)\net10.0\FengSync.Cli.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AutomationCliFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAutomationCliToPublish" AfterTargets="Publish">
    <ItemGroup>
      <AutomationCliPublishFiles Include="$(MSBuildProjectDirectory)\..\FengSync.Cli\bin\$(Configuration)\net10.0\FengSync.Cli.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AutomationCliPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
