<Window x:Class="FengSync.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:l="clr-namespace:FengSync.Localization"
        Title="{Binding [Progress.WindowTitle], Source={l:Lang}}"
        Width="820"
        Height="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        AutomationProperties.AutomationId="ProgressWindow"
        AutomationProperties.Name="{Binding [Progress.WindowTitle], Source={l:Lang}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <fluent:FluentIcon x:Name="StateIcon"
                                   Icon="ArrowSync"
                                   Width="32"
                                   Height="32"
                                   FontSize="32"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource LibraryIconStyle}"
                                   AutomationProperties.Name="{Binding [Progress.StateIcon], Source={l:Lang}}" />
                <StackPanel>
                    <TextBlock x:Name="StateTitle"
                               Text="{Binding [Progress.Syncing], Source={l:Lang}}"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Name="StateDescription"
                               Text="{Binding [Progress.PreparingTransfer], Source={l:Lang}}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding [Progress.Progress], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="Counter"
                               DockPanel.Dock="Right"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar x:Name="FileProgress"
                             Height="8"
                             Margin="0,8,0,0"
                             AutomationProperties.Name="{Binding [Progress.FileProgressName], Source={l:Lang}}" />
                <TextBlock x:Name="CurrentFile"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextStyle}"
                           AutomationProperties.AutomationId="ProgressCurrentFile" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding [Progress.FileTransfersBytes], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}" />
                        <ProgressBar x:Name="BytesGraph"
                                     Height="6"
                                     Margin="0,12,0,0"
                                     AutomationProperties.Name="{Binding [Progress.BytesProgressName], Source={l:Lang}}" />
                        <TextBlock x:Name="BytesText"
                                   AutomationProperties.AutomationId="ProgressBytesText"
                                   Text="{Binding [Progress.WaitingTransfer], Source={l:Lang}}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="16"
                        Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [Progress.SpeedElapsed], Source={l:Lang}}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="SpeedText"
                                   AutomationProperties.AutomationId="ProgressSpeedText"
                                   Text="0 B/s"
                                   Style="{StaticResource MetricTextStyle}"
                                   MinHeight="52"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <GroupBox Grid.Row="3" Header="{Binding [Progress.OperationDetails], Source={l:Lang}}" Margin="0,16,0,0">
                <DataGrid x:Name="OperationResults"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          AutomationProperties.Name="{Binding [Progress.OperationDetailsName], Source={l:Lang}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding [Progress.ColStage], Source={l:Lang}}" Binding="{Binding StageText}" Width="90" />
                        <DataGridTextColumn Header="{Binding [Progress.ColOperation], Source={l:Lang}}" Binding="{Binding KindText}" Width="115" />
                        <DataGridTextColumn Header="{Binding [Progress.ColPath], Source={l:Lang}}" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="{Binding [Progress.ColErrorAdvice], Source={l:Lang}}" Binding="{Binding Error}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel>
                <CheckBox x:Name="AutoClose"
                          Content="{Binding [Progress.AutoClose], Source={l:Lang}}"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding [Progress.AutoCloseName], Source={l:Lang}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveLogButton"
                            Click="SaveLog_Click"
                            IsEnabled="False"
                            Style="{StaticResource TertiaryButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding [Progress.SaveLogName], Source={l:Lang}}"
                            Content="{Binding [Progress.SaveLog], Source={l:Lang}}" />
                    <Button x:Name="RetryButton"
                            Click="Retry_Click"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding [Progress.RetryFailedName], Source={l:Lang}}"
                            Content="{Binding [Progress.RetryFailed], Source={l:Lang}}" />
                    <Button x:Name="CloseButton"
                            Click="Close_Click"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="{Binding [Progress.CloseName], Source={l:Lang}}"
                            Content="{Binding [Progress.Close], Source={l:Lang}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
