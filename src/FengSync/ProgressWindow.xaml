<Window x:Class="FengSync.ProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="同步进度" Width="820" Height="680" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" Background="{DynamicResource WindowBackgroundBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="132"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><TextBlock x:Name="StateIcon" Text="⟳" FontSize="32" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0"/><StackPanel><TextBlock x:Name="StateTitle" Text="正在同步" Style="{StaticResource PageTitleTextStyle}"/><TextBlock x:Name="StateDescription" Text="正在准备传输…" Foreground="{DynamicResource SecondaryForegroundBrush}"/></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,18,0,0"><DockPanel><TextBlock Text="进度" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Name="Counter" DockPanel.Dock="Right"/></DockPanel><ProgressBar x:Name="FileProgress" Height="14" Margin="0,6,0,0"/><TextBlock x:Name="CurrentFile" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}"/></StackPanel>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="7"><StackPanel><TextBlock Text="文件传输 / 字节" Style="{StaticResource SectionTitleTextStyle}"/><ProgressBar x:Name="BytesGraph" Height="5" Margin="0,12,0,0"/><TextBlock x:Name="BytesText" Text="等待传输" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="7" Margin="0,8,0,0"><StackPanel><TextBlock Text="速度 / 用时" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Name="SpeedText" Text="0 B/s" Margin="0,12,0,0"/></StackPanel></Border></Grid>
  <GroupBox Grid.Row="3" Header="操作详情" Margin="0,14,0,0"><DataGrid x:Name="OperationResults" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding StageText}" Width="90"/><DataGridTextColumn Header="操作" Binding="{Binding Kind}" Width="115"/><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="错误 / 建议" Binding="{Binding Error}" Width="2*"/></DataGrid.Columns></DataGrid></GroupBox>
  <DockPanel Grid.Row="4" Margin="0,15,0,0"><CheckBox x:Name="AutoClose" Content="完成后自动关闭" VerticalAlignment="Center"/><Button x:Name="CloseButton" DockPanel.Dock="Right" Click="Close_Click" IsEnabled="False" Padding="20,6">关闭</Button><Button x:Name="RetryButton" DockPanel.Dock="Right" Click="Retry_Click" IsEnabled="False" Padding="12,6" Margin="0,0,8,0">重试失败项</Button><Button x:Name="SaveLogButton" DockPanel.Dock="Right" Click="SaveLog_Click" IsEnabled="False" Padding="12,6" Margin="0,0,8,0">保存日志</Button></DockPanel>
 </Grid>
</Window>
