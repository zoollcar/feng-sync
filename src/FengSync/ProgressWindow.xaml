<Window x:Class="FengSync.ProgressWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="同步进度" Width="610" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" Background="#F7F7F7">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><TextBlock x:Name="StateIcon" Text="⟳" FontSize="32" Foreground="#159447" Margin="0,0,10,0"/><StackPanel><TextBlock x:Name="StateTitle" Text="正在同步" FontSize="19" FontWeight="Bold"/><TextBlock x:Name="StateDescription" Text="正在准备传输…" Foreground="#52606D"/></StackPanel></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,18,0,0"><DockPanel><TextBlock Text="进度" FontWeight="Bold"/><TextBlock x:Name="Counter" DockPanel.Dock="Right"/></DockPanel><ProgressBar x:Name="FileProgress" Height="14" Margin="0,6,0,0"/><TextBlock x:Name="CurrentFile" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" Foreground="#52606D"/></StackPanel>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#AEB6BE" BorderThickness="1" Padding="7"><StackPanel><TextBlock Text="文件 / 字节" FontWeight="Bold"/><ProgressBar x:Name="BytesGraph" Height="5" Margin="0,12,0,0"/><TextBlock x:Name="BytesText" Text="等待传输" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Row="1" BorderBrush="#AEB6BE" BorderThickness="1" Padding="7" Margin="0,8,0,0"><StackPanel><TextBlock Text="速度 / 用时" FontWeight="Bold"/><ProgressBar x:Name="SpeedGraph" Height="5" Margin="0,12,0,0"/><TextBlock x:Name="SpeedText" Text="0 B/s" Margin="0,8,0,0"/></StackPanel></Border></Grid>
  <DockPanel Grid.Row="3" Margin="0,15,0,0"><CheckBox x:Name="AutoClose" Content="完成后自动关闭" VerticalAlignment="Center"/><Button x:Name="CloseButton" DockPanel.Dock="Right" Click="Close_Click" IsEnabled="False" Padding="20,6">关闭</Button></DockPanel>
 </Grid>
</Window>
