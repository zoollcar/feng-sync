<Window x:Class="FengSync.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="同步进度"
        Width="820"
        Height="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        AutomationProperties.AutomationId="ProgressWindow"
        AutomationProperties.Name="同步进度">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="132" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <fluent:FluentIcon x:Name="StateIcon"
                                   Icon="ArrowSync"
                                   Width="32"
                                   Height="32"
                                   FontSize="32"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource LibraryIconStyle}"
                                   AutomationProperties.Name="同步状态图标" />
                <StackPanel>
                    <TextBlock x:Name="StateTitle"
                               Text="正在同步"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Name="StateDescription"
                               Text="正在准备传输…"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="进度" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="Counter"
                               DockPanel.Dock="Right"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar x:Name="FileProgress"
                             Height="8"
                             Margin="0,8,0,0"
                             AutomationProperties.Name="当前文件传输进度" />
                <TextBlock x:Name="CurrentFile"
                           Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextStyle}"
                           AutomationProperties.Name="当前正在处理的文件" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="文件传输 / 字节" Style="{StaticResource SectionTitleTextStyle}" />
                        <ProgressBar x:Name="BytesGraph"
                                     Height="6"
                                     Margin="0,12,0,0"
                                     AutomationProperties.Name="已传输字节进度" />
                        <TextBlock x:Name="BytesText"
                                   Text="等待传输"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="16"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="速度 / 用时" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:Name="SpeedText"
                                   Text="0 B/s"
                                   Style="{StaticResource MetricTextStyle}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <GroupBox Grid.Row="3" Header="操作详情" Margin="0,16,0,0">
                <DataGrid x:Name="OperationResults"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          AutomationProperties.Name="同步操作详情">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Binding="{Binding StageText}" Width="90" />
                        <DataGridTextColumn Header="操作" Binding="{Binding Kind}" Width="115" />
                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="错误 / 建议" Binding="{Binding Error}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel>
                <CheckBox x:Name="AutoClose"
                          Content="完成后自动关闭"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="同步完成后自动关闭窗口" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveLogButton"
                            Click="SaveLog_Click"
                            IsEnabled="False"
                            Style="{StaticResource TertiaryButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="保存本次运行日志">保存日志</Button>
                    <Button x:Name="RetryButton"
                            Click="Retry_Click"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="重试失败项">重试失败项</Button>
                    <Button x:Name="CloseButton"
                            Click="Close_Click"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="关闭同步进度窗口">关闭</Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
