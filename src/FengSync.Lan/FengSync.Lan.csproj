<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <!--
      Kestrel inside a desktop process. A FrameworkReference rather than individual Microsoft.AspNetCore.*
      packages: those stopped shipping standalone, and hand-picking them leaves a version-churn graph. It
      deliberately does NOT live in FengSync.Core, because Core's ProjectReference flows into FengSync.Cli,
      which is published framework-dependent — adding ASP.NET Core there would demand a second installed
      shared framework from an executable that never needed one.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FengSync.Core\FengSync.Core.csproj" />
  </ItemGroup>
</Project>
